/* components/login-panel/login-panel.wxss - 登录引导面板（半屏弹层） */
/* 注意：全屏遮罩 z-index 必须 ≥ 10000（自定义 tabBar z-index=1000 之上） */
/* 2026-09-09 层级上调至 20000：页面业务弹层（首页 10001 / 成长 10000 / 日程 11000~12000）
   曾盖住登录面板导致「登录按钮被遮挡、点击无响应」。登录引导是全局最顶层交互，
   必须高于所有业务弹层。 */
.lp-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20000;
  background: rgba(33, 26, 19, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.lp-card {
  width: 100%;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 16rpx 48rpx calc(env(safe-area-inset-bottom) + 48rpx);
  box-sizing: border-box;
  animation: lp-slide-up 0.25s ease-out;
}

@keyframes lp-slide-up {
  from { transform: translateY(60rpx); opacity: 0.6; }
  to   { transform: translateY(0); opacity: 1; }
}

.lp-grabber {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #F0E8DE;
  margin: 8rpx auto 32rpx;
}

.lp-head {
  text-align: center;
  margin-bottom: 44rpx;
}

.lp-logo {
  width: 112rpx;
  height: 112rpx;
  line-height: 112rpx;
  text-align: center;
  font-size: 60rpx;
  background: var(--color-primary-bg, #F5EBDD);
  border-radius: 32rpx;
  margin: 0 auto 24rpx;
}

.lp-title {
  font-size: var(--font-lg, 36rpx);
  font-weight: 600;
  color: var(--color-text-primary, #3D3027);
}

.lp-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-hint, #B5A795);
  line-height: 1.6;
}

.lp-btn-primary {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #D4B896, #C0A07A);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(212, 184, 150, 0.35);
  /* 2026-09-09：文字居中修复 — button 内部用 flex 布局，代替 line-height 居中，
     避免个别机型/基础库下文字偏上、left 偏移 */
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
  margin: 0;
  box-sizing: border-box;
}

.lp-btn-primary::after {
  border: none;
}

.lp-btn-hover {
  opacity: 0.88;
  transform: scale(0.99);
}

.lp-btn-disabled {
  opacity: 0.6;
}

.lp-ghost {
  margin-top: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: #FAF6F0;
  color: var(--color-text-secondary, #8B7D6E);
  font-size: 30rpx;
}

.lp-ghost-hover {
  background: #F5EBDD;
}

/* ===== 协议勾选（合规：默认不勾选） ===== */
.lp-agree-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: center;
  margin-top: 28rpx;
  padding: 4rpx 8rpx;
}

.lp-agree-check {
  width: 36rpx;
  height: 36rpx;
  min-width: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #D8CBB8;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.lp-agree-check.lp-agree-checked {
  background: linear-gradient(135deg, #D4B896, #C0A07A);
  border-color: #C0A07A;
}

.lp-check-mark {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 700;
  line-height: 1;
}

.lp-check-hover {
  opacity: 0.8;
}

.lp-agree-text {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #8B7D6E;
  line-height: 1.6;
  flex: 1;
  text-align: left;
}

.lp-protocol {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #C9BEB1;
}

.lp-link {
  color: var(--color-primary-dark, #C0A07A);
  font-weight: 600;
}