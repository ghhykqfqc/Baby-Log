/* components/record-button/record-button.wxss */

.record-btn {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  max-width: 280rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--btn-color, #D4B896);
  box-shadow: 0 8rpx 32rpx rgba(212, 184, 150, 0.35);
  transition: all 0.2s ease;
  overflow: hidden;
  user-select: none;
}

.record-btn.pressing {
  transform: scale(0.92);
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 150, 0.25);
}

.record-btn.disabled {
  opacity: 0.5;
}

.btn-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.btn-icon {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 12rpx;
}

.btn-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.elapsed-text {
  position: absolute;
  bottom: -48rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-hint);
  white-space: nowrap;
}

/* 成功反馈层 */
.success-layer {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  z-index: 3;
  animation: fadeOut 1.2s ease forwards;
}

.success-icon {
  font-size: 80rpx;
  color: #7FB069;
  font-weight: bold;
}

.success-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

@keyframes fadeOut {
  0%, 60% { opacity: 1; }
  100% { opacity: 0; }
}
