/* components/timeline-card/timeline-card.wxss - 重构版：直接删除按钮 */

.timeline-item {
  position: relative;
  margin-bottom: 16rpx;
  animation: itemFadeIn 0.35s ease both;
}

@keyframes itemFadeIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 卡片主体 */
.card-wrapper {
  position: relative;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  transition: transform 0.15s ease;
  z-index: 2;
}

.card-hover {
  transform: scale(0.98);
  background: #FBF7F1;
}

/* 左侧色彩竖条 */
.color-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
}

.card-inner {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx 24rpx 24rpx;
}

/* 图标 */
.card-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

/* 内容 */
.card-body {
  flex: 1;
  min-width: 0;
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.card-time {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  font-variant-numeric: tabular-nums;
}

.card-extra-row {
  margin-top: 8rpx;
}

.extra-text {
  display: inline-block;
  font-size: var(--font-xs);
  color: var(--color-primary-dark);
  background: var(--color-primary-bg);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

/* 右侧直接显示的删除按钮 */
.del-btn {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(232, 85, 78, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  transition: background 0.15s ease, transform 0.15s ease;
}

.del-btn-hover {
  background: rgba(232, 85, 78, 0.18);
  transform: scale(0.9);
}

.del-icon {
  font-size: 28rpx;
  color: var(--color-danger);
  line-height: 1;
}