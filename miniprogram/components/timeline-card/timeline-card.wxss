/* components/timeline-card/timeline-card.wxss */

.timeline-item {
  position: relative;
  display: flex;
  align-items: center;
  padding-left: 0;
  animation: itemFadeIn 0.4s ease both;
}

@keyframes itemFadeIn {
  from { opacity: 0; transform: translateX(20rpx); }
  to { opacity: 1; transform: translateX(0); }
}

/* 左侧时间轴 */
.axis {
  position: relative;
  width: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  padding-top: 28rpx;
}

.axis-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 6rpx rgba(212, 184, 150, 0.2);
  z-index: 2;
}

.axis-line {
  position: absolute;
  top: 0;
  width: 2rpx;
  height: 100%;
  background: var(--color-divider);
}

/* 卡片主体 */
.card-wrapper {
  flex: 1;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin: 8rpx 24rpx 8rpx 0;
  box-shadow: var(--shadow-card);
}

.card-content {
  display: flex;
  align-items: center;
}

.card-left {
  margin-right: 20rpx;
}

.card-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-sm);
  background: var(--color-primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.card-body {
  flex: 1;
}

.card-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.card-time {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.card-extra {
  margin-left: 16rpx;
}

.extra-text {
  font-size: var(--font-sm);
  color: var(--color-primary);
  background: var(--color-primary-bg);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 删除按钮 */
.delete-btn {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  background: var(--color-danger);
  color: #FFFFFF;
  border-radius: var(--radius-sm);
  padding: 20rpx 28rpx;
  font-size: var(--font-sm);
  z-index: 1;
}
