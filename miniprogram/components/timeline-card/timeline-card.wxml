<!-- components/timeline-card/timeline-card.wxml -->
<view class="timeline-item" style="animation-delay: {{index * 40}}ms;">
  <!-- 可滑动卡片 -->
  <view
    class="card-wrapper {{showDelete ? 'shifted' : ''}}"
    bindtouchstart="handleTouchStart"
    bindtouchmove="handleTouchMove"
    bindtouchend="handleTouchEnd"
    bindtap="handleCardTap"
  >
    <!-- 左侧色彩竖条（替代原来的时间轴点） -->
    <view class="color-bar" style="background: {{record.color}};"></view>

    <view class="card-inner">
      <!-- 图标 -->
      <view class="card-icon" style="background: {{record.color}}22;">
        {{record.icon}}
      </view>

      <!-- 内容主体 -->
      <view class="card-body">
        <view class="card-title-row">
          <text class="card-title">{{record.label}}</text>
          <text class="card-time">{{record.timeText}}</text>
        </view>
        <view class="card-extra-row" wx:if="{{record.extra}}">
          <text class="extra-text">{{record.extra}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 删除按钮 -->
  <view class="delete-btn" bindtap="handleDelete">
    <view class="del-icon">✕</view>
    <text class="del-text">删除</text>
  </view>
</view>
