/* pages/schedule/schedule.wxss - 日程页（日历 + 事项列表）
   设计风格：奶咖色系 · 清新可爱 · 圆润柔和 · 类别色温柔醒目 */

/* 整页锁定一屏：列布局 */
.page-schedule {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 24rpx 32rpx 0;
  padding-bottom: calc(env(safe-area-inset-bottom) + 110rpx);
  background: var(--color-bg);
}

/* ============================================
   顶部标题区（可爱徽章图标 + 温柔副标题）
   ============================================ */
.sched-header {
  flex-shrink: 0;
  padding: 8rpx 0 20rpx;
}

.sched-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sched-title-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

/* 可爱徽章图标：圆润奶咖底 + 兔兔 */
.sched-title-icon {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #F7E8D2 0%, #EAD3B4 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(212, 184, 150, 0.35);
  flex-shrink: 0;
}

.sched-title-icon-emoji {
  font-size: 48rpx;
  line-height: 1;
}

/* 徽章右上角小装饰点 */
.sched-title-icon::after {
  content: '';
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #F5C6AA;
  border: 4rpx solid #FFFFFF;
  box-sizing: content-box;
}

.sched-title-text {
  min-width: 0;
  flex: 1;
}

.sched-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  letter-spacing: 1rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sched-subtitle {
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 「今天」胶囊按钮 */
.sched-today-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--color-primary-dark);
  background: var(--color-primary-bg);
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  flex-shrink: 0;
  border: 2rpx solid rgba(212, 184, 150, 0.35);
}

.sched-today-pill-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E89B7B;
}

.pill-hover {
  background: var(--color-primary-light);
  transform: scale(0.96);
}

/* ============================================
   最近未来事项倒计时 tips
   ============================================ */
.sched-tips {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, #FDF3E3 0%, #FAE7D0 100%);
  border: 2rpx solid rgba(212, 184, 150, 0.3);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 150, 0.15);
}

.sched-tips-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(212, 184, 150, 0.25);
}

.sched-tips-body {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.sched-tips-text {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sched-tips-label {
  font-size: 20rpx;
  color: #C08A50;
  font-weight: 600;
  letter-spacing: 2rpx;
  align-self: flex-start;
}

.sched-tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sched-tips-date {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-variant-numeric: tabular-nums;
}

/* 倒计时数字块 */
.sched-tips-count {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.sched-count-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 56rpx;
  background: #FFFFFF;
  border-radius: 14rpx;
  padding: 6rpx 8rpx;
  box-shadow: 0 3rpx 8rpx rgba(212, 184, 150, 0.2);
}

.sched-count-num {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.sched-count-unit {
  font-size: 18rpx;
  color: var(--color-text-hint);
  line-height: 1.2;
}

/* ============================================
   日历卡
   ============================================ */
.calendar-card {
  flex-shrink: 0;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 20rpx 16rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(240, 232, 222, 0.8);
}

/* 月份切换 */
.cal-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
}

.cal-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--color-text-secondary);
  border-radius: 50%;
  font-weight: 300;
  line-height: 1;
  background: var(--color-bg);
  transition: all 0.15s ease;
}

.arrow-hover {
  background: var(--color-primary-bg);
  color: var(--color-primary-dark);
  transform: scale(0.92);
}

.cal-month-label {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.cal-month-year {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
}

.cal-month-sep {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.cal-month-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  letter-spacing: 2rpx;
  font-variant-numeric: tabular-nums;
}

/* 星期表头 */
.cal-weekdays {
  display: flex;
  padding: 0 0 12rpx;
}

.cal-weekday {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-hint);
  font-weight: 500;
}

.cal-weekday-end {
  color: #E8A88F;
}

/* 日期网格：7 列（弹层化后格子加大） */
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-day {
  position: relative;
  flex: 0 0 calc(100% / 7);
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  transition: background 0.15s ease;
}

.cal-day-out {
  opacity: 0.32;
}

.cal-day-hover {
  background: var(--color-primary-bg);
}

/* 数字容器：固定宽高圆形，彻底解决垂直不居中 */
.cal-day-num-wrap {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-day-num {
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

/* 今天：圆圈画在数字容器上，绝对居中 */
.cal-day-today .cal-day-num-wrap::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: 3rpx solid #E8A88F;
  border-radius: 50%;
  pointer-events: none;
}

.cal-day-today .cal-day-num {
  color: #D67E5A;
  font-weight: 700;
}

/* 选中态：实心暖色底（画在数字容器上，居中且不撑满格子） */
.cal-day-selected .cal-day-num-wrap {
  background: linear-gradient(135deg, #E8B990 0%, #D4B896 100%);
  box-shadow: 0 4rpx 12rpx rgba(212, 184, 150, 0.45);
}

.cal-day-selected .cal-day-num {
  color: #FFFFFF;
  font-weight: 700;
}

/* 选中 + 今天：圈改为白色描边（保留"今天"识别） */
.cal-day-selected.cal-day-today .cal-day-num-wrap::before {
  border-color: #FFFFFF;
  top: -4rpx;
  left: -4rpx;
  right: -4rpx;
  bottom: -4rpx;
}

/* ===== 有事项的日期：柔和浅色底（比小圆点更醒目） ===== */
.cal-day-has-vaccine     { background: rgba(232, 85, 78, 0.10); }
.cal-day-has-birthday    { background: rgba(245, 166, 35, 0.12); }
.cal-day-has-appointment { background: rgba(108, 163, 197, 0.12); }
.cal-day-has-class       { background: rgba(155, 107, 217, 0.10); }
.cal-day-has-shopping    { background: rgba(127, 176, 105, 0.12); }
.cal-day-has-gift        { background: rgba(212, 184, 150, 0.16); }
.cal-day-has-redpacket   { background: rgba(228, 73, 61, 0.10); }
.cal-day-has-custom      { background: rgba(139, 125, 110, 0.10); }
.cal-day-has-other       { background: rgba(139, 125, 110, 0.10); }
.cal-day-has-important   { background: rgba(228, 73, 61, 0.14); }

/* 选中态优先级最高：覆盖事项底色 */
.cal-day-selected.cal-day-has-vaccine,
.cal-day-selected.cal-day-has-birthday,
.cal-day-selected.cal-day-has-appointment,
.cal-day-selected.cal-day-has-class,
.cal-day-selected.cal-day-has-shopping,
.cal-day-selected.cal-day-has-gift,
.cal-day-selected.cal-day-has-redpacket,
.cal-day-selected.cal-day-has-custom,
.cal-day-selected.cal-day-has-other,
.cal-day-selected.cal-day-has-important {
  background: transparent;
}

/* 事项标记点：贴着数字容器底部 */
.cal-day-dots {
  position: absolute;
  bottom: 10rpx;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
}

.cal-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-text-hint);
}

/* 各类别色（与 categoryOptions 对应，custom 为自定义类别统一样式） */
.cal-dot-vaccine     { background: #E8554E; }
.cal-dot-birthday    { background: #F5A623; }
.cal-dot-appointment { background: #6CA3C5; }
.cal-dot-class       { background: #9B6BD9; }
.cal-dot-shopping    { background: #7FB069; }
.cal-dot-gift        { background: #D4B896; }
.cal-dot-redpacket   { background: #E4493D; }
.cal-dot-custom      { background: #8B7D6E; }
.cal-dot-other       { background: #8B7D6E; }
.cal-dot-important   { background: #E4493D; box-shadow: 0 0 0 3rpx rgba(228,73,61,0.18); }

.cal-dot-more {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--color-text-hint);
  opacity: 0.6;
}

/* 选中态下的小点改为白色 */
.cal-day-selected .cal-dot,
.cal-day-selected .cal-dot-more {
  background: rgba(255,255,255,0.9) !important;
  box-shadow: none !important;
}

/* ============================================
   选中日摘要条（主页面，点击弹层）
   ============================================ */
.sched-day-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  border: 2rpx solid rgba(240, 232, 222, 0.8);
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(180,150,110,0.08);
}

.sched-day-bar-hover {
  transform: scale(0.99);
  background: #FDFBF7;
}

.sched-day-bar-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
  flex: 1;
}

.sched-day-bar-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  min-width: 88rpx;
}

.sched-day-bar-day {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  line-height: 1.2;
}

.sched-day-bar-week {
  font-size: 20rpx;
  color: var(--color-text-hint);
  line-height: 1.3;
}

.sched-day-bar-divider {
  width: 2rpx;
  height: 48rpx;
  background: var(--color-divider);
  flex-shrink: 0;
}

.sched-day-bar-summary {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  font-size: 26rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.sched-day-bar-hint {
  font-size: 20rpx;
  color: var(--color-text-hint);
  font-weight: 400;
}

/* 摘要条上的快捷添加按钮 */
.sched-day-bar-add {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: var(--color-primary-bg);
  border: 2rpx solid rgba(212, 184, 150, 0.35);
  color: var(--color-primary-dark);
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.sched-day-bar-add-icon {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

/* 底部弹性留白（整页不滚动，多余空间留白） */
.sched-flex-spacer {
  flex: 1;
  min-height: 20rpx;
}

/* ============================================
   当日事项弹层
   ============================================ */
.sched-day-sheet {
  width: 100%;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
  border-radius: 40rpx 40rpx 0 0;
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 24rpx);
  box-sizing: border-box;
  animation: sheetUp 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.sched-sheet-scroll {
  flex: 1;
  min-height: 0;
  max-height: calc(82vh - 160rpx);
}

.sched-day-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
  color: var(--color-text-secondary);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  line-height: 1;
}

/* 弹层内头部标题 */
.sched-day-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 20rpx;
  flex-shrink: 0;
}

.sched-day-title {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.sched-day-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.sched-day-week {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

/* 弹层内列表容器 */
.sched-list-inner {
  padding: 0 4rpx;
}

/* 加载 / 空状态 */
.sched-loading {
  text-align: center;
  color: var(--color-text-hint);
  font-size: 26rpx;
  padding: 40rpx 0;
}.sched-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0 40rpx;
}

.sched-empty-icon {
  font-size: 80rpx;
  line-height: 1;
  opacity: 0.7;
}

.sched-empty-text {
  font-size: 30rpx;
  color: var(--color-text-secondary);
  margin-top: 20rpx;
  font-weight: 500;
}

.sched-empty-sub {
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-top: 8rpx;
}

/* 事项卡片 */
.sched-item {
  position: relative;
  display: flex;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx 24rpx 24rpx 36rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(180,150,110,0.08);
  overflow: hidden;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.sched-item-hover {
  transform: scale(0.985);
  box-shadow: 0 4rpx 18rpx rgba(180,150,110,0.16);
}

/* 左侧类别色条：圆头胶囊 */
.sched-item-bar {
  position: absolute;
  left: 12rpx;
  top: 20rpx;
  bottom: 20rpx;
  width: 8rpx;
  border-radius: 4rpx;
  background: var(--color-text-hint);
}

/* 各类别条色 */
.sched-cat-vaccine     .sched-item-bar { background: #E8554E; }
.sched-cat-birthday    .sched-item-bar { background: #F5A623; }
.sched-cat-appointment .sched-item-bar { background: #6CA3C5; }
.sched-cat-class       .sched-item-bar { background: #9B6BD9; }
.sched-cat-shopping    .sched-item-bar { background: #7FB069; }
.sched-cat-gift        .sched-item-bar { background: #D4B896; }
.sched-cat-redpacket   .sched-item-bar { background: #E4493D; }
.sched-cat-custom      .sched-item-bar { background: #8B7D6E; }
.sched-cat-other       .sched-item-bar { background: #8B7D6E; }

/* 重要事项：背景轻微染色 */
.sched-item-important {
  background: linear-gradient(180deg, #FFF5F4 0%, #FFFFFF 60%);
}

.sched-item-important .sched-item-bar {
  background: #E4493D !important;
  width: 10rpx;
}

.sched-item-body {
  flex: 1;
  min-width: 0;
}

.sched-item-row1 {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sched-item-icon {
  font-size: 32rpx;
  line-height: 1;
}

.sched-item-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sched-item-cat {
  font-size: 20rpx;
  color: var(--color-text-hint);
  background: var(--color-bg);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.sched-item-row2 {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.sched-item-time,
.sched-item-loc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-variant-numeric: tabular-nums;
}

.sched-item-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-hint);
  line-height: 1.5;
  background: var(--color-bg);
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
}

/* 添加事项按钮 */
.sched-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  border: 2rpx dashed var(--color-primary-light);
  color: var(--color-primary-dark);
  font-size: 28rpx;
  font-weight: 500;
  margin: 12rpx 0 0;
}

.sched-add-hover {
  background: var(--color-primary-bg);
  transform: scale(0.985);
}

.sched-add-icon {
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}

/* ============================================
   通用弹层遮罩（新增/编辑表单弹层，层级高于当日事项弹层）
   ============================================ */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(61, 48, 39, 0.45);
  z-index: 11000;
  display: flex;
  align-items: flex-end;
  animation: maskIn 0.25s ease;
}

@keyframes maskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.sched-form-sheet {
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  background: var(--color-bg);
  border-radius: 40rpx 40rpx 0 0;
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  animation: sheetUp 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}

@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--color-divider);
  margin: 8rpx auto 20rpx;
}

.sched-form-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: 20rpx;
}

.sched-form-item {
  margin-bottom: 20rpx;
}

/* 标签行：标签 + 提示 + 收藏按钮 */
.sched-form-label-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.sched-form-label-inline {
  font-size: 24rpx;
  color: var(--color-text-hint);
  font-weight: 500;
  flex-shrink: 0;
}

.sched-form-label-tip {
  font-size: 20rpx;
  color: #C9BBA8;
  flex-shrink: 0;
}

/* 「存为常用」收藏按钮（有输入才显示） */
.sched-fav-add {
  display: none;
  align-items: center;
  gap: 4rpx;
  margin-left: auto;
  font-size: 22rpx;
  color: #C08A50;
  background: #FDF3E3;
  border: 2rpx solid rgba(212, 184, 150, 0.35);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.sched-fav-add.show {
  display: flex;
}

.sched-fav-add-text {
  font-size: 20rpx;
}

/* 常用事项横向滚动条 */
.sched-fav-scroll {
  width: 100%;
  white-space: nowrap;
}

.sched-fav-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 0 8rpx;
}

.sched-fav-chip {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: var(--color-bg-card);
  border: 2rpx solid rgba(212, 184, 150, 0.35);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  flex-shrink: 0;
}

.sched-fav-chip-text {
  font-size: 24rpx;
  color: var(--color-text-primary);
}

.sched-fav-chip-del {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #FBE9E7;
  color: var(--color-danger);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  flex-shrink: 0;
}

/* 管理按钮 */
.sched-fav-manage {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--color-primary-dark);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-primary-bg);
  flex-shrink: 0;
}

.sched-form-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-bottom: 10rpx;
}

.sched-form-input {
  width: 100%;
  height: 88rpx;
  background: var(--color-bg-card);
  border-radius: 20rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.sched-form-input-inline {
  height: 76rpx;
}

.sched-form-textarea {
  width: 100%;
  min-height: 100rpx;
  background: var(--color-bg-card);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.5;
}

.sched-form-picker {
  height: 88rpx;
  background: var(--color-bg-card);
  border-radius: 20rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

/* 内联两列 */
.sched-form-row-inline {
  display: flex;
  gap: 20rpx;
}

.sched-form-half {
  flex: 1;
  min-width: 0;
}

/* ===== 更多选项折叠区（+ 号） ===== */
.sched-more-section {
  margin-bottom: 20rpx;
  background: var(--color-bg-card);
  border-radius: 20rpx;
  overflow: hidden;
}

.sched-more-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  gap: 12rpx;
}

.sched-more-toggle-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

/* + 号图标：展开时旋转成 × */
.sched-more-toggle-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-primary-bg);
  color: var(--color-primary-dark);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  flex-shrink: 0;
  transition: transform 0.25s ease, background 0.25s ease;
}

.sched-more-toggle-icon.open {
  transform: rotate(45deg);
  background: var(--color-primary-light);
}

.sched-more-toggle-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 折叠时显示已填字段的 emoji 徽标 */
.sched-more-badges {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.sched-more-badge {
  font-size: 24rpx;
  background: var(--color-bg);
  border-radius: 10rpx;
  padding: 4rpx 10rpx;
  line-height: 1.3;
}

.sched-more-body {
  padding: 0 24rpx 20rpx;
  animation: fadeIn 0.25s ease;
}

/* 类别选择网格 */
.sched-cat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sched-cat-pill {
  flex: 1 1 calc(25% - 16rpx);
  min-width: calc(25% - 16rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s ease;
}

.sched-cat-pill.active {
  background: var(--color-primary-bg);
  border-color: var(--color-primary);
  box-shadow: 0 4rpx 12rpx rgba(212, 184, 150, 0.25);
}

.sched-cat-hover {
  transform: scale(0.95);
}

.sched-cat-pill-icon {
  font-size: 32rpx;
  line-height: 1;
}

.sched-cat-pill-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.sched-cat-pill.active .sched-cat-pill-text {
  color: var(--color-primary-dark);
  font-weight: 600;
}

/* 「＋」自定义入口：虚线描边 */
.sched-cat-add {
  border: 2rpx dashed var(--color-primary-light);
  background: transparent;
}

.sched-cat-add-icon {
  color: var(--color-primary-dark);
  font-weight: 600;
}

/* ============================================
   自定义类别编辑弹层（居中卡片）
   ============================================ */
.cat-editor-mask {
  z-index: 12000;
  align-items: center;
  justify-content: center;
}

.sched-cat-editor {
  width: 580rpx;
  background: var(--color-bg);
  border-radius: 32rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(61, 48, 39, 0.2);
  animation: catEditorIn 0.25s cubic-bezier(0.22, 0.61, 0.36, 1);
}

@keyframes catEditorIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

.sched-cat-editor-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: center;
}

.sched-cat-editor-sub {
  font-size: 22rpx;
  color: var(--color-text-hint);
  text-align: center;
  margin-top: 8rpx;
}

.sched-cat-editor-input {
  width: 100%;
  height: 88rpx;
  background: var(--color-bg-card);
  border-radius: 20rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: var(--color-text-primary);
  margin-top: 28rpx;
}

.sched-cat-editor-error {
  font-size: 22rpx;
  color: var(--color-danger);
  margin-top: 12rpx;
  text-align: center;
  min-height: 32rpx;
}

.sched-cat-editor-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.sched-cat-editor-cancel,
.sched-cat-editor-save {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.sched-cat-editor-cancel {
  background: var(--color-primary-light);
  color: var(--color-text-secondary);
}

.sched-cat-editor-save {
  background: var(--color-primary);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: var(--shadow-button);
}

/* 重要开关 */
.sched-important-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-bg-card);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.sched-important-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.sched-important-icon {
  font-size: 40rpx;
  line-height: 1;
}

.sched-important-text {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.sched-important-sub {
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-top: 4rpx;
}

/* 自定义开关 */
.sched-switch {
  width: 80rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: var(--color-divider);
  position: relative;
  transition: background 0.2s ease;
  flex-shrink: 0;
}

.sched-switch.on {
  background: #E8A88F;
}

.sched-switch-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
  transition: left 0.2s ease;
}

.sched-switch.on .sched-switch-knob {
  left: 40rpx;
}

/* 操作按钮组 */
.sched-form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.sched-form-cancel,
.sched-form-del,
.sched-form-save {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.sched-form-cancel {
  background: var(--color-primary-light);
  color: var(--color-text-secondary);
}

.sched-form-del {
  flex: 0.8;
  background: #FBE9E7;
  color: var(--color-danger);
}

.sched-form-save {
  flex: 1.4;
  background: var(--color-primary);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: var(--shadow-button);
}

.btn-hover {
  transform: scale(0.97);
}
