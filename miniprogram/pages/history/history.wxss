/* pages/history/history.wxss - 成长历史记录（顶部统计 + 纵向滚动 + 分页） */

.page-history {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
  /* 底部让出自定义 tabBar（实际 navigateTo 页无 tabBar，但保留安全区） */
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--color-bg);
}

/* ===== 顶部统计卡 ===== */
.stat-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(180, 150, 110, 0.10);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  display: block;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  display: block;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--color-divider);
}

/* ===== 滚动列表区 ===== */
.list-scroll {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.list-loading,
.list-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-text {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: var(--font-md);
  color: var(--color-text-primary);
  font-weight: 500;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

/* ===== 历史项 ===== */
.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(180, 150, 110, 0.06);
  transition: transform 0.15s ease;
}

.history-item-hover {
  transform: scale(0.98);
  background: #FAF6F0;
}

.history-date {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.history-day {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.history-age {
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-top: 4rpx;
}

.history-values {
  display: flex;
  gap: 24rpx;
}

.history-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.history-value-miss {
  color: var(--color-text-hint);
  font-weight: 400;
}

.history-unit {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  font-weight: 400;
  margin-left: 2rpx;
}

/* ===== 分页加载状态 ===== */
.list-footer {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 8rpx;
}

.footer-text {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.footer-end {
  opacity: 0.7;
}

.footer-hint {
  opacity: 0.8;
}

.list-tip {
  text-align: center;
  font-size: 20rpx;
  color: var(--color-text-hint);
  margin-top: 16rpx;
  opacity: 0.7;
}

.scroll-tail {
  height: 24rpx;
}
