/* pages/history/history.wxss - 成长历史记录（顶部统计 + 纵向滚动 + 分页） */

.page-history {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
  /* 底部让出自定义 tabBar（实际 navigateTo 页无 tabBar，但保留安全区） */
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--color-bg);
}

/* ===== 顶部统计卡 ===== */
.stat-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(180, 150, 110, 0.10);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  display: block;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  display: block;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--color-divider);
}

/* ===== 滚动列表区 ===== */
.list-scroll {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.list-loading,
.list-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-text {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: var(--font-md);
  color: var(--color-text-primary);
  font-weight: 500;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

/* ===== 历史项 ===== */
.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(180, 150, 110, 0.06);
  transition: transform 0.15s ease;
}

.history-item-hover {
  transform: scale(0.98);
  background: #FAF6F0;
}

.history-date {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.history-day {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.history-age {
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-top: 4rpx;
}

.history-values {
  display: flex;
  gap: 24rpx;
}

.history-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.history-value-miss {
  color: var(--color-text-hint);
  font-weight: 400;
}

.history-unit {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  font-weight: 400;
  margin-left: 2rpx;
}

/* 编辑 + 删除按钮 */
.action-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.edit-btn,
.del-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s ease, transform 0.15s ease;
}

.edit-btn { background: rgba(108, 163, 197, 0.08); }
.del-btn { background: rgba(232, 85, 78, 0.08); }

.action-btn-hover {
  transform: scale(0.9);
}

.action-btn-hover.edit-btn,
.edit-btn:hover { background: rgba(108, 163, 197, 0.18); }
.action-btn-hover.del-btn,
.del-btn:hover { background: rgba(232, 85, 78, 0.18); }

.action-icon {
  width: 28rpx;
  height: 28rpx;
}

/* ===== 编辑弹层 ===== */
.sheet-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 10000;
  display: flex;
  align-items: flex-end;
  animation: maskIn 0.25s ease;
}

@keyframes maskIn { from { opacity: 0; } to { opacity: 1; } }

.form-sheet {
  width: 100%;
  background: var(--color-bg);
  border-radius: 40rpx 40rpx 0 0;
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  animation: sheetUp 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}

@keyframes sheetUp { from { transform: translateY(100%); } to { transform: translateY(0); } }

.sheet-handle { width: 64rpx; height: 8rpx; border-radius: 4rpx; background: var(--color-divider); margin: 8rpx auto 24rpx; }
.form-title { font-size: 36rpx; font-weight: 600; color: var(--color-text-primary); text-align: center; margin-bottom: 32rpx; }
.form-item { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 24rpx; color: var(--color-text-secondary); margin-bottom: 12rpx; margin-left: 4rpx; }
.form-field { display: flex; align-items: center; background: var(--color-bg-card); border-radius: 20rpx; padding: 0 28rpx; height: 96rpx; box-shadow: 0 2rpx 8rpx rgba(180, 150, 110, 0.06); }
.field-picker { justify-content: space-between; }
.field-text { font-size: 30rpx; color: var(--color-text-primary); font-weight: 500; }
.field-arrow { font-size: 24rpx; color: var(--color-text-hint); }
.field-input { flex: 1; font-size: 36rpx; font-weight: 500; color: var(--color-text-primary); font-variant-numeric: tabular-nums; }
.field-unit { font-size: 26rpx; color: var(--color-text-secondary); margin-left: 12rpx; }
.form-actions { display: flex; gap: 20rpx; margin-top: 40rpx; }
.btn-cancel, .btn-confirm { flex: 1; height: 96rpx; border-radius: 48rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 600; transition: transform 0.15s ease; }
.btn-hover { transform: scale(0.97); }
.btn-cancel { background: var(--color-divider); color: var(--color-text-secondary); }
.btn-confirm { background: var(--color-primary); color: #FFFFFF; box-shadow: 0 6rpx 20rpx rgba(212, 184, 150, 0.35); }
.list-footer {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 8rpx;
}

.footer-text {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.footer-end {
  opacity: 0.7;
}

.footer-hint {
  opacity: 0.8;
}

.list-tip {
  text-align: center;
  font-size: 20rpx;
  color: var(--color-text-hint);
  margin-top: 16rpx;
  opacity: 0.7;
}

.scroll-tail {
  height: 24rpx;
}
