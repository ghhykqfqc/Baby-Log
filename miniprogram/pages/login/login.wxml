<!-- pages/login/login.wxml - 登录/注册（游客可跳过，先体验后授权） -->
<view class="login-page">
  <!-- 顶部品牌区 -->
  <view class="brand">
    <view class="logo">👶</view>
    <view class="brand-title">贝贝log</view>
    <view class="brand-subtitle">极简育儿记录，一家人共同守护</view>
  </view>

  <!-- 登录卡片 -->
  <view class="card">
    <view class="card-title">开始记录宝宝的每一天</view>
    <view class="card-desc">登录后可永久保存数据并与家人共享；游客模式也随时可用</view>

    <!-- 微信一键登录（官方推荐：getPhoneNumber 获取手机号；头像昵称选填） -->
    <button
      class="primary-btn {{logging ? 'disabled' : ''}}"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
      disabled="{{logging}}"
      hover-class="btn-hover"
    >
      <text wx:if="{{!logging}}">微信一键登录</text>
      <text wx:else>登录中...</text>
    </button>

    <!-- 协议勾选（默认不勾选；未勾选点登录会提示） -->
    <view class="agreement-row">
      <view
        class="agree-check {{agreed ? 'agreed' : ''}}"
        bindtap="onToggleAgreement"
        hover-class="check-hover"
        aria-role="checkbox"
        aria-checked="{{agreed}}"
        aria-label="同意用户协议和隐私政策"
      >
        <text class="check-mark" wx:if="{{agreed}}">✓</text>
      </view>
      <view class="agree-text" bindtap="onToggleAgreement">
        <text>我已阅读并同意</text>
        <text class="protocol-link" catchtap="viewUserAgreement">《用户协议》</text>
        <text>和</text>
        <text class="protocol-link" catchtap="viewPrivacyPolicy">《隐私政策》</text>
      </view>
    </view>

    <!-- 游客入口（先体验，后授权） -->
    <view class="guest-row" bindtap="enterAsGuest" hover-class="btn-hover">
      暂不登录，先逛逛
    </view>
  </view>

  <!-- 协议提示（底部，已升级为可点击的链接） -->
  <view class="protocol">
    登录即表示同意 <text class="protocol-link" bindtap="viewUserAgreement">《用户协议》</text> 和 <text class="protocol-link" bindtap="viewPrivacyPolicy">《隐私政策》</text>
  </view>
</view>