/* pages/login/login.wxss */
.login-page {
  --bg: #FAF6F0;
  --primary: #D4B896;
  --primary-dark: #B8966C;
  --text-main: #3A2E22;
  --text-sub: #8C7A66;
  --card-bg: #FFFFFF;
  --radius-card: 40rpx;

  position: relative;
  width: 100vw;
  height: 100vh;
  min-height: 100vh;
  background: linear-gradient(180deg, #FAF6F0 0%, #F2E8D8 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* 顶部品牌区 */
.brand {
  margin-top: 16vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 12rpx 40rpx rgba(180, 150, 110, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 88rpx;
  line-height: 1;
}

.brand-title {
  margin-top: 32rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: var(--text-main);
  letter-spacing: 4rpx;
}

.brand-subtitle {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: var(--text-sub);
  letter-spacing: 1rpx;
}

/* 登录卡片 */
.card {
  margin-top: 80rpx;
  width: 100%;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 56rpx 48rpx 48rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 40rpx rgba(180, 150, 110, 0.15);
}

.card-title {
  font-size: 36rpx;
  color: var(--text-main);
  font-weight: 600;
}

.card-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 44rpx;
}

/* 头像选择按钮 */
.login-btn {
  width: 100%;
  height: 140rpx;
  background: #FAF6F0;
  border-radius: 28rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
  border: none;
  margin-bottom: 28rpx;
}

.login-btn::after {
  border: none;
}

.btn-hover {
  background: #F0E6D4;
}

.login-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.login-avatar.placeholder {
  background: #E6D8C0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.login-btn-text {
  margin-left: 24rpx;
  flex: 1;
  text-align: left;
}

.login-btn-title {
  font-size: 30rpx;
  color: var(--text-main);
  font-weight: 500;
}

.login-btn-tip {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 昵称输入 */
.nickname-row {
  width: 100%;
  height: 100rpx;
  background: #FAF6F0;
  border-radius: 28rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  margin-bottom: 44rpx;
}

.nickname-input {
  width: 100%;
  height: 100rpx;
  font-size: 30rpx;
  color: var(--text-main);
}

/* 主按钮 */
.primary-btn {
  width: 100%;
  height: 96rpx;
  background: var(--primary);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 150, 0.4);
}

.primary-btn::after {
  border: none;
}

.primary-btn.disabled {
  background: #DCD2C2;
  color: rgba(255, 255, 255, 0.7);
  box-shadow: none;
}

/* 协议 */
.protocol {
  position: absolute;
  bottom: calc(env(safe-area-inset-bottom) + 40rpx);
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-sub);
}

.protocol-link {
  color: var(--primary-dark);
}
