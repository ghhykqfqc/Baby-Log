<!-- pages/profile/profile.wxml - 宝宝资料编辑（完整字段：头像、昵称、生日、性别、宝宝密码） -->
<view class="page-profile">

  <!-- 页面标题（区分新建/编辑） -->
  <view class="page-title">{{babyId ? '编辑宝宝' : '新建宝宝'}}</view>

  <!-- ===== 头像预览（点击选图） ===== -->
  <view class="avatar-block" bindtap="chooseAvatar" hover-class="avatar-tap" hover-stay-time="80">
    <view class="avatar-ring">
      <image
        wx:if="{{avatarUrl}}"
        class="avatar-img"
        src="{{avatarUrl}}"
        mode="aspectFill"
      ></image>
      <view wx:else class="avatar-emoji">👶</view>
      <view class="camera-badge">
        <text class="camera-icon">📷</text>
      </view>
    </view>
    <view class="avatar-tip">点击更换头像</view>
  </view>

  <!-- ===== 宝宝 ID 与密码（仅编辑已有宝宝时显示） ===== -->
  <view class="id-block" wx:if="{{babyId}}">
    <view class="id-row">
      <text class="id-label">宝宝 ID</text>
      <text class="id-value" selectable="{{true}}" user-select="{{true}}">{{babyId}}</text>
      <view class="id-copy-btn" bindtap="copyBabyId" hover-class="btn-hover">复制</view>
    </view>
    <view class="id-tip">把这个 ID 和宝宝密码分享给家人，他们就能加入并一起记录啦</view>

    <view class="id-row">
      <text class="id-label">宝宝密码</text>
      <input class="id-input" type="number" password="{{true}}" maxlength="6"
        placeholder="6 位数字" value="{{babyCode}}" bindinput="onCodeInput" />
    </view>
    <view class="id-tip">修改密码后保存生效，家人加入时需输入新密码</view>
  </view>

  <!-- ===== 表单字段 ===== -->
  <view class="form-block">
    <view class="form-label">昵称</view>
    <view class="form-field">
      <input
        class="form-input"
        type="text"
        maxlength="12"
        placeholder="给宝宝起个昵称"
        placeholder-class="form-placeholder"
        value="{{babyName}}"
        bindinput="onNameInput"
        confirm-type="done"
      />
      <text class="form-count">{{babyName.length}}/12</text>
    </view>
  </view>

  <view class="form-block">
    <view class="form-label">生日</view>
    <picker mode="date" value="{{birthDate}}" bindchange="onBirthChange">
      <view class="form-field form-field-picker">
        <text class="form-text {{birthDate ? '' : 'form-placeholder'}}">{{birthDate || '请选择生日'}}</text>
        <text class="form-arrow">›</text>
      </view>
    </picker>
  </view>

  <view class="form-block">
    <view class="form-label">性别</view>
    <view class="gender-row">
      <view class="gender-opt {{gender === 'male' ? 'active' : ''}}" data-gender="male" bindtap="onGenderTap" hover-class="btn-hover">👦 男</view>
      <view class="gender-opt {{gender === 'female' ? 'active' : ''}}" data-gender="female" bindtap="onGenderTap" hover-class="btn-hover">👧 女</view>
    </view>
  </view>

  <!-- ===== 保存按钮 ===== -->
  <view class="save-btn-wrap">
    <view
      class="save-btn {{(!babyName || submitting) ? 'save-btn-disabled' : ''}}"
      bindtap="save"
      hover-class="btn-hover"
    >
      {{submitting ? '保存中…' : '保存'}}
    </view>
  </view>

  <!-- ===== 裁剪弹层 ===== -->
  <view class="cropper-mask" wx:if="{{cropperVisible}}">
    <view class="cropper-header">
      <view class="cropper-btn-cancel" bindtap="cancelCrop">取消</view>
      <view class="cropper-title">调整头像</view>
      <view class="cropper-btn-done" bindtap="confirmCrop">完成</view>
    </view>

    <view
      class="cropper-stage"
      style="width: {{cropperSize}}px; height: {{cropperSize}}px;"
      bindtouchstart="onCropTouchStart"
      bindtouchmove="onCropTouchMove"
      bindtouchend="onCropTouchEnd"
    >
      <image
        class="cropper-image"
        src="{{rawImagePath}}"
        style="width: {{imgW}}px; height: {{imgH}}px; left: {{imgX}}px; top: {{imgY}}px;"
        mode="scaleToFill"
      ></image>
      <!-- 中心镂空遮罩（box-shadow 扩展实现） -->
      <view
        class="cropper-frame"
        style="left: {{cropLeft}}px; top: {{cropTop}}px; width: {{cropSize}}px; height: {{cropSize}}px;"
      ></view>
    </view>

    <view class="cropper-tip">拖动调整位置 · 双指缩放</view>
  </view>

  <!-- 隐藏的裁剪导出 canvas（不参与布局） -->
  <canvas type="2d" id="cropCanvas" class="crop-canvas-hidden"></canvas>
</view>
