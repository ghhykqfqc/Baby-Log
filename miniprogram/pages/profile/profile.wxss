/* pages/profile/profile.wxss - 宝宝资料页 */

.page-profile {
  min-height: 100vh;
  padding: 0 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

/* ===== 头像区（官方 chooseAvatar 按钮） ===== */
.avatar-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0 56rpx;
}

/* 适配 button 的 reset */
.avatar-block-btn {
  padding: 24rpx 0 32rpx;
}

.avatar-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: inherit;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar-ring {
  position: relative;
  width: 184rpx;
  height: 184rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  padding: 6rpx;
  box-shadow: 0 8rpx 32rpx rgba(212, 184, 150, 0.35);
}

.avatar-img,
.avatar-emoji {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  background: #F5EBDD;
}

.avatar-emoji {
  font-size: 96rpx;
}

/* 审核中：默认灰色头像 + 右下角旋转小圆点徽标 */
.avatar-auditing-emoji {
  font-size: 96rpx;
  filter: grayscale(1);
  opacity: 0.6;
}

.avatar-auditing-badge {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #8A8A8A;
  color: #FFFFFF;
  font-size: 18rpx;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  border: 3rpx solid #FFFFFF;
  white-space: nowrap;
}

.avatar-auditing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FFD76A;
  animation: audit-pulse 1.2s ease-in-out infinite;
}

@keyframes audit-pulse {
  0%, 100% { opacity: 0.4; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

.camera-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #FFFFFF;
}

.camera-icon {
  font-size: 28rpx;
  line-height: 1;
}

.avatar-tip {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 24rpx;
}

.avatar-tap {
  opacity: 0.85;
}

/* ===== 表单 ===== */
.form-block {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  margin-left: 8rpx;
}

.form-field {
  display: flex;
  align-items: center;
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 0 28rpx;
  height: 104rpx;
  box-shadow: 0 2rpx 8rpx rgba(180, 150, 110, 0.06);
}

.form-input {
  flex: 1;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  min-width: 0;
}

.form-placeholder {
  color: var(--color-text-hint);
  font-weight: 400;
  font-size: 30rpx;
}

.form-count {
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ===== 保存按钮 ===== */
.save-btn-wrap {
  margin-top: auto;
  padding: 32rpx 0 calc(env(safe-area-inset-bottom) + 40rpx);
}

.save-btn {
  height: 96rpx;
  border-radius: 48rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(212, 184, 150, 0.35);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.save-btn-loading {
  opacity: 0.7;
}

.btn-hover {
  transform: scale(0.97);
}

/* ============================================
   页面标题 / ID 区 / 性别选择
   ============================================ */
.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary, #3A2E22);
  text-align: center;
  padding: 8rpx 0 24rpx;
}

.id-block {
  background: #FBF5EB;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.id-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.id-label {
  width: 140rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary, #8C7A66);
  flex-shrink: 0;
}

.id-value {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--color-text-primary, #3A2E22);
  font-family: monospace;
}

.id-input {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  color: var(--color-text-primary, #3A2E22);
  font-family: monospace;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  height: 60rpx;
  box-sizing: border-box;
}

.id-copy-btn {
  margin-left: 16rpx;
  padding: 8rpx 20rpx;
  background: var(--color-primary, #D4B896);
  color: #FFFFFF;
  font-size: 22rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.id-tip {
  font-size: 22rpx;
  color: var(--color-text-hint, #B5A795);
  line-height: 1.6;
  margin-top: 8rpx;
  padding-bottom: 8rpx;
}

/* 性别选择 */
.gender-row {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.gender-opt {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--color-bg-card, #FFFFFF);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--color-text-secondary, #8C7A66);
  border: 2rpx solid transparent;
}

.gender-opt.active {
  background: var(--color-primary, #D4B896);
  color: #FFFFFF;
  border-color: var(--color-primary, #D4B896);
}

/* picker 字段样式 */
.form-field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-text {
  font-size: 30rpx;
  color: var(--color-text-primary, #3A2E22);
}

.form-arrow {
  font-size: 36rpx;
  color: var(--color-text-hint, #B5A795);
}

/* 保存按钮禁用态 */
.save-btn-disabled {
  background: #DCD2C2 !important;
  box-shadow: none !important;
}
