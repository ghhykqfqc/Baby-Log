/* pages/growth/growth.wxss - 成长日志（瘦身版：焦点数据 + 曲线） */

.page-growth {
  min-height: 100vh;
  padding: 24rpx 32rpx 160rpx;
  box-sizing: border-box;
}

/* ===== 宝宝档案 ===== */
.profile {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 4rpx 24rpx;
}

.profile-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.profile-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  overflow: hidden;
  transition: transform 0.15s ease;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-emoji {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-tap {
  transform: scale(0.94);
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.2;
}

.profile-meta {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.profile-age {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 22rpx;
  background: var(--color-primary-bg);
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.age-text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.age-label {
  font-size: 18rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

/* ===== 最新数据焦点卡 ===== */
.metric-card {
  position: relative;
  background: var(--color-bg-card);
  border-radius: 32rpx;
  padding: 36rpx 32rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(180, 150, 110, 0.10);
  display: flex;
}

/* 历史入口按钮（右上角胶囊，小巧不抢焦点） */
.history-entry {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 18rpx;
  background: var(--color-primary-bg);
  border-radius: 24rpx;
  transition: transform 0.15s ease, background 0.2s ease;
  z-index: 2;
}

.history-entry-hover {
  transform: scale(0.94);
  background: var(--color-primary-light);
}

.history-entry-icon {
  font-size: 22rpx;
  line-height: 1;
}

.history-entry-text {
  font-size: 22rpx;
  color: var(--color-primary-dark);
  font-weight: 500;
}

.metric-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.metric-divider {
  width: 1rpx;
  background: var(--color-divider);
  margin: 8rpx 0;
}

.metric-num-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.metric-num {
  font-size: 76rpx;
  font-weight: 200;
  color: var(--color-text-primary);
  line-height: 1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -2rpx;
}

.metric-unit {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.metric-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 10rpx;
}

.metric-delta {
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: transparent;
}

.metric-delta.up {
  color: #7FB069;
  background: rgba(127, 176, 105, 0.10);
}

.metric-delta.down {
  color: #E8554E;
  background: rgba(232, 85, 78, 0.08);
}

.metric-date {
  position: absolute;
  bottom: 14rpx;
  right: 28rpx;
  font-size: 20rpx;
  color: var(--color-text-hint);
}

/* 无数据占位卡 */
.metric-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 32rpx;
}

.metric-empty-icon {
  font-size: 64rpx;
  margin-bottom: 18rpx;
}

.metric-empty-title {
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 500;
  margin-bottom: 8rpx;
}

.metric-empty-sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

/* ===== 生长曲线卡 ===== */
.chart-card {
  background: var(--color-bg-card);
  border-radius: 32rpx;
  padding: 24rpx 20rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(180, 150, 110, 0.08);
}

.chart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 14rpx;
}

.chart-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.chart-tabs {
  display: flex;
  background: var(--color-primary-bg);
  border-radius: 24rpx;
  padding: 4rpx;
}

.chart-tab {
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  border-radius: 20rpx;
  transition: all 0.25s ease;
}

.chart-tab.active {
  background: var(--color-primary);
  color: #FFFFFF;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(212, 184, 150, 0.35);
}

.growth-chart {
  width: 100%;
  height: 340rpx;
}

/* 空状态 */
.empty-wrap {
  margin-top: 40rpx;
}

/* ===== 浮动按钮 ===== */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(env(safe-area-inset-bottom) + 140rpx);
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: var(--color-primary);
  box-shadow: 0 8rpx 32rpx rgba(212, 184, 150, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.fab-hover {
  transform: scale(0.92);
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 150, 0.35);
}

.fab-icon {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

/* ===== 录入弹层 ===== */
.sheet-mask {
  position: fixed;
  /* 不用 inset 简写：部分安卓 WebView（X5 内核 < Chromium 87）不支持，会导致 fixed 失效、弹层被 tabBar 遮挡 */
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 10000;           /* 必须高于自定义 tabBar 的 1000，否则底部被遮盖 */
  display: flex;
  align-items: flex-end;
  animation: maskIn 0.25s ease;
}

@keyframes maskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.form-sheet {
  width: 100%;
  background: var(--color-bg);
  border-radius: 40rpx 40rpx 0 0;
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  animation: sheetUp 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}

@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--color-divider);
  margin: 8rpx auto 24rpx;
}

.form-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: center;
}

.form-sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
  margin-top: 8rpx;
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  margin-left: 4rpx;
}

.form-field {
  display: flex;
  align-items: center;
  background: var(--color-bg-card);
  border-radius: 20rpx;
  padding: 0 28rpx;
  height: 96rpx;
  box-shadow: 0 2rpx 8rpx rgba(180, 150, 110, 0.06);
}

.field-picker {
  justify-content: space-between;
}

.field-text {
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.field-arrow {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.field-input {
  flex: 1;
  font-size: 36rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.field-placeholder {
  color: var(--color-text-hint);
  font-weight: 400;
  font-size: 30rpx;
}

.field-unit {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-left: 12rpx;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: transform 0.15s ease;
}

.btn-hover {
  transform: scale(0.97);
}

.btn-cancel {
  background: var(--color-divider);
  color: var(--color-text-secondary);
}

.btn-confirm {
  background: var(--color-primary);
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(212, 184, 150, 0.35);
}

.btn-disabled {
  opacity: 0.6;
}
