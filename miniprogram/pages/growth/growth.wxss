/* pages/growth/growth.wxss */

.page-growth {
  min-height: 100vh;
  padding: 24rpx 32rpx 140rpx;
  box-sizing: border-box;
}

/* 信息卡 */
.info-card {
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

.info-value {
  color: var(--color-text-primary);
  font-weight: 500;
  font-size: var(--font-sm);
}

/* 图表区 */
.chart-section {
  margin-bottom: 24rpx;
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.chart-title {
  font-size: var(--font-lg);
  font-weight: 600;
}

.chart-tabs {
  display: flex;
  background: var(--color-primary-bg);
  border-radius: 20rpx;
  padding: 4rpx;
}

.tab {
  padding: 8rpx 28rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  border-radius: 18rpx;
  transition: all 0.2s;
}

.tab.active {
  background: var(--color-primary);
  color: #FFFFFF;
}

.growth-chart {
  width: 100%;
  height: 400rpx;
}

.chart-tip {
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  margin-top: 16rpx;
}

/* 历史列表 */
.history-section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: var(--font-md);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.history-item:last-child {
  border-bottom: none;
}

.hist-date {
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

.hist-data {
  display: flex;
  gap: 24rpx;
  color: var(--color-text-primary);
  font-size: var(--font-sm);
  font-weight: 500;
}

/* 浮动按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: calc(env(safe-area-inset-bottom) + 140rpx);
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-button);
  z-index: 10;
}

/* 表单弹窗 */
.form-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.form-sheet {
  width: 100%;
  background: var(--color-bg);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 40rpx 32rpx calc(env(safe-area-inset-bottom) + 40rpx);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.form-title {
  font-size: var(--font-xl);
  font-weight: 600;
  text-align: center;
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.form-item input,
.picker-value {
  width: 100%;
  padding: 24rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  box-sizing: border-box;
}

.form-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  padding: 24rpx;
  border-radius: var(--radius-md);
  text-align: center;
  font-size: var(--font-md);
  font-weight: 600;
}

.btn-cancel {
  background: var(--color-divider);
  color: var(--color-text-secondary);
}

.btn-confirm {
  background: var(--color-primary);
  color: #FFFFFF;
}
