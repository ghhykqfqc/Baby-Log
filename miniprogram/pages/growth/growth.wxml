<!-- pages/growth/growth.wxml - 成长日志（瘦身版：焦点数据 + 曲线，历史移独立页） -->
<view class="page-growth">

  <!-- ========== 宝宝档案 ========== -->
  <view class="profile">
    <view class="profile-left">
      <view class="profile-avatar" bindtap="goProfile" hover-class="avatar-tap" hover-stay-time="80">
        <image wx:if="{{babyInfo.avatar}}" class="avatar-img" src="{{babyInfo.avatar}}" mode="aspectFill"></image>
        <view wx:else class="avatar-emoji">👶</view>
      </view>
      <view class="profile-info">
        <view class="profile-name">{{babyInfo.name || '宝宝'}}</view>
        <view class="profile-meta">{{birthLabel}}</view>
      </view>
    </view>
    <view class="profile-age" wx:if="{{ageText}}">
      <view class="age-text">{{ageText.full}}</view>
      <view class="age-label">月龄</view>
    </view>
  </view>

  <!-- ========== 最新数据（焦点区，带历史入口按钮） ========== -->
  <view class="metric-card" wx:if="{{!loading && latest}}">
    <!-- 右上角历史入口：小巧胶囊按钮 -->
    <view class="history-entry" wx:if="{{records.length > 0}}" bindtap="goHistory" hover-class="history-entry-hover">
      <text class="history-entry-icon">📋</text>
      <text class="history-entry-text">历史 {{records.length}}</text>
    </view>

    <view class="metric-col">
      <view class="metric-num-row">
        <text class="metric-num">{{latest.height || '--'}}</text>
        <text class="metric-unit">cm</text>
      </view>
      <view class="metric-label">身高</view>
      <view class="metric-delta {{latest.heightDeltaClass}}">{{latest.heightDeltaText}}</view>
    </view>
    <view class="metric-divider"></view>
    <view class="metric-col">
      <view class="metric-num-row">
        <text class="metric-num">{{latest.weight || '--'}}</text>
        <text class="metric-unit">kg</text>
      </view>
      <view class="metric-label">体重</view>
      <view class="metric-delta {{latest.weightDeltaClass}}">{{latest.weightDeltaText}}</view>
    </view>
    <view class="metric-date" wx:if="{{latest.measureDate}}">更新于 {{latest.measureDate}}</view>
  </view>

  <!-- 无数据时的占位卡 -->
  <view class="metric-card metric-empty" wx:if="{{!loading && !latest}}">
    <view class="metric-empty-icon">📏</view>
    <view class="metric-empty-title">记录第一次成长</view>
    <view class="metric-empty-sub">定格身高与体重的起点，见证每一次长大</view>
  </view>

  <!-- ========== 生长曲线 ==========
       弹窗打开期间卸载 canvas：部分真机同层渲染失效，canvas 会浮在弹层之上 -->
  <view class="chart-card" wx:if="{{hasRecords && !showForm}}">
    <view class="chart-head">
      <view class="chart-title">生长曲线</view>
      <view class="chart-tabs">
        <view class="chart-tab {{chartType === 'weight' ? 'active' : ''}}" data-type="weight" bindtap="switchChart">体重</view>
        <view class="chart-tab {{chartType === 'height' ? 'active' : ''}}" data-type="height" bindtap="switchChart">身高</view>
      </view>
    </view>
    <canvas type="2d" id="growthChart" class="growth-chart"></canvas>
  </view>

  <!-- 空状态 -->
  <view class="empty-wrap" wx:if="{{!loading && !hasRecords}}">
    <empty-state icon="📈" title="还没有成长记录" subtitle="点击右下角按钮，记录宝宝的身高体重" />
  </view>

  <!-- ========== 录入按钮 ========== -->
  <view class="fab" bindtap="showAddForm" hover-class="fab-hover" hover-stay-time="100">
    <text class="fab-icon">＋</text>
  </view>

  <!-- ========== 录入弹层 ========== -->
  <view class="sheet-mask" wx:if="{{showForm}}" bindtap="hideForm" catchtouchmove="noop">
    <view class="form-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="form-title">记录成长</view>
      <view class="form-sub">身高、体重至少填写一项</view>

      <!-- 测量日期 -->
      <view class="form-item">
        <text class="form-label">测量日期</text>
        <picker mode="date" value="{{formData.measureDate}}" start="{{minDate}}" end="{{maxDate}}" bindchange="onDateChange">
          <view class="form-field field-picker">
            <text class="field-text">{{formData.measureDate}}</text>
            <text class="field-arrow">▾</text>
          </view>
        </picker>
      </view>

      <!-- 身高 -->
      <view class="form-item">
        <text class="form-label">身高</text>
        <view class="form-field">
          <input
            class="field-input"
            type="digit"
            placeholder="如 70.5"
            placeholder-class="field-placeholder"
            value="{{formData.height}}"
            focus="{{focusHeight}}"
            confirm-type="next"
            bindinput="onHeightInput"
            bindconfirm="focusWeightField"
            cursor-spacing="32"
          />
          <text class="field-unit">cm</text>
        </view>
      </view>

      <!-- 体重 -->
      <view class="form-item">
        <text class="form-label">体重</text>
        <view class="form-field">
          <input
            class="field-input"
            type="digit"
            placeholder="如 8.2"
            placeholder-class="field-placeholder"
            value="{{formData.weight}}"
            focus="{{focusWeight}}"
            confirm-type="done"
            bindinput="onWeightInput"
            bindconfirm="submitGrowth"
            cursor-spacing="32"
          />
          <text class="field-unit">kg</text>
        </view>
      </view>

      <view class="form-actions">
        <view class="btn-cancel" bindtap="hideForm" hover-class="btn-hover">取消</view>
        <view class="btn-confirm {{submitting ? 'btn-disabled' : ''}}" bindtap="submitGrowth" hover-class="btn-hover">
          {{submitting ? '保存中…' : '保存'}}
        </view>
      </view>
    </view>
  </view>
</view>
