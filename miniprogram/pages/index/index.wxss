/* pages/index/index.wxss - 首页（天气皮肤 + 预测卡 + 相册 + 单行记录） */

/* 整页锁定一屏：不滚动，相册区弹性伸缩适配各机型 */
.page-index {
  position: relative;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
}

/* 内容层：浮在天气背景之上（弹性列布局） */
.content-layer {
  position: relative;
  z-index: 1;
  height: 100vh;
  padding: 24rpx 32rpx 0;
  /* 底部让出自定义 tabBar（110rpx + 安全区） */
  padding-bottom: calc(env(safe-area-inset-bottom) + 110rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* ============================================
   天气皮肤背景层
   ============================================ */
.weather-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

/* ---- 基础天空（晴：蓝天白云，底部过渡回奶咖底色） ---- */
.wx-sunny {
  background: linear-gradient(180deg, #C4E5F8 0%, #DFF1FB 32%, #F3EEE3 70%, #FAF6F0 100%);
}

.sun-glow {
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 244, 200, 0.9) 0%, rgba(255, 240, 190, 0.35) 45%, rgba(255, 240, 190, 0) 70%);
  animation: sunPulse 6s ease-in-out infinite;
}@keyframes sunPulse {
  0%, 100% { transform: scale(1); opacity: 0.9; }
  50% { transform: scale(1.06); opacity: 1; }
}

/* ---- 云朵 ---- */
.cloud {
  --cloud-scale: 1;
  position: absolute;
  width: 220rpx;
  height: 70rpx;
  border-radius: 60rpx;
  background: rgba(255, 255, 255, 0.85);
  filter: blur(2rpx);
  box-shadow: 40rpx -28rpx 0 8rpx rgba(255, 255, 255, 0.75),
              -46rpx -20rpx 0 0 rgba(255, 255, 255, 0.65),
              90rpx 6rpx 0 -6rpx rgba(255, 255, 255, 0.55);
}

.cloud-1 {
  top: 90rpx;
  left: -260rpx;
  animation: drift 46s linear infinite;
}

.cloud-2 {
  top: 240rpx;
  left: -300rpx;
  --cloud-scale: 0.7;
  opacity: 0.8;
  animation: drift 64s linear infinite;
  animation-delay: -20s;
}

.cloud-3 {
  top: 60rpx;
  left: -220rpx;
  --cloud-scale: 1.2;
  opacity: 0.55;
  animation: drift 80s linear infinite;
  animation-delay: -48s;
}

.cloud-dim {
  background: rgba(240, 242, 244, 0.8);
  box-shadow: 40rpx -28rpx 0 8rpx rgba(240, 242, 244, 0.7),
              -46rpx -20rpx 0 0 rgba(240, 242, 244, 0.6),
              90rpx 6rpx 0 -6rpx rgba(240, 242, 244, 0.5);
}

@keyframes drift {
  from { transform: translateX(0) scale(var(--cloud-scale)); }
  to { transform: translateX(calc(100vw + 600rpx)) scale(var(--cloud-scale)); }
}

/* ---- 多云 ---- */
.wx-cloudy {
  background: linear-gradient(180deg, #D8E2E8 0%, #E9E9E4 35%, #F5F1EA 70%, #FAF6F0 100%);
}

/* ---- 雨：玻璃雨水朦胧感 ---- */
.wx-rain {
  background: linear-gradient(180deg, #C3D5E0 0%, #DCE7EE 35%, #EFEFE9 70%, #F6F3EC 100%);
}

/* 磨砂玻璃水雾面 */
.glass-mist {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    radial-gradient(ellipse 60% 40% at 20% 30%, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 70%),
    radial-gradient(ellipse 50% 35% at 80% 55%, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0) 70%),
    radial-gradient(ellipse 70% 45% at 50% 15%, rgba(226, 238, 246, 0.5) 0%, rgba(226, 238, 246, 0) 75%);
}

/* 雨滴动画 Canvas：覆盖整个背景层 */
.rain-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 旧的 CSS 雨丝层（已废弃，保留兜底；新版用 Canvas 渲染更真实） */
.rain-layer {
  position: absolute;
  top: -200rpx;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: repeating-linear-gradient(
    102deg,
    transparent 0,
    transparent 52rpx,
    rgba(174, 194, 224, 0.30) 52rpx,
    rgba(174, 194, 224, 0.30) 54rpx,
    transparent 54rpx
  );
  animation: rainFall 1.1s linear infinite;
}

@keyframes rainFall {
  from { transform: translateY(-140rpx); }
  to { transform: translateY(140rpx); }
}

/* 玻璃上的水珠（装饰，保留） */
.droplet {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.85), rgba(200, 218, 236, 0.35) 60%, rgba(200, 218, 236, 0.15));
  box-shadow: inset -4rpx -6rpx 14rpx rgba(160, 185, 212, 0.4);
  animation: dropletSlide 7s ease-in infinite;
}

.droplet-1 {
  width: 46rpx;
  height: 46rpx;
  top: 18%;
  left: 12%;
}

.droplet-2 {
  width: 30rpx;
  height: 30rpx;
  top: 34%;
  right: 16%;
  animation-delay: -3.5s;
}

@keyframes dropletSlide {
  0% { transform: translateY(0) scale(1); opacity: 0; }
  15% { opacity: 1; }
  85% { opacity: 1; }
  100% { transform: translateY(300rpx) scale(1.15); opacity: 0; }
}

/* ---- 雪 ---- */
.wx-snow {
  background: linear-gradient(180deg, #D6E2EC 0%, #E9EFF4 35%, #F4F2EC 70%, #FAF6F0 100%);
}

.snow-layer {
  position: absolute;
  top: -200rpx;
  left: 0;
  right: 0;
  bottom: 0;
  background-image:
    radial-gradient(circle 6rpx at 40rpx 100rpx, rgba(255, 255, 255, 0.95) 90%, transparent),
    radial-gradient(circle 4rpx at 160rpx 220rpx, rgba(255, 255, 255, 0.8) 90%, transparent),
    radial-gradient(circle 5rpx at 280rpx 60rpx, rgba(255, 255, 255, 0.85) 90%, transparent),
    radial-gradient(circle 3rpx at 340rpx 280rpx, rgba(255, 255, 255, 0.75) 90%, transparent);
  background-size: 400rpx 340rpx;
  animation: snowFall 9s linear infinite;
}

@keyframes snowFall {
  from { transform: translateY(0); }
  to { transform: translateY(340rpx); }
}

/* ---- 风：风絮落叶飘零 ---- */
.wx-wind {
  background: linear-gradient(180deg, #E4E0CF 0%, #EFEAD9 35%, #F5F0E4 70%, #FAF6F0 100%);
}

.leaf {
  position: absolute;
  font-size: 40rpx;
  opacity: 0;
  animation: leafBlow 11s ease-in infinite;
}

.leaf-1 { top: 16%; font-size: 48rpx; animation-duration: 12s; }
.leaf-2 { top: 30%; animation-delay: -2.5s; animation-duration: 10s; }
.leaf-3 { top: 8%; font-size: 36rpx; animation-delay: -5s; animation-duration: 14s; }
.leaf-4 { top: 24%; font-size: 32rpx; animation-delay: -7.5s; animation-duration: 9s; }
.leaf-5 { top: 40%; font-size: 42rpx; animation-delay: -4s; animation-duration: 13s; }

@keyframes leafBlow {
  0% { transform: translate(-120rpx, 0) rotate(0deg); opacity: 0; }
  8% { opacity: 0.75; }
  50% { transform: translate(45vw, -70rpx) rotate(300deg); opacity: 0.65; }
  90% { opacity: 0.3; }
  100% { transform: translate(110vw, 60rpx) rotate(680deg); opacity: 0; }
}

/* ============================================
   顶部统一信息条（用户头像 + 宝宝切换入口 + 天气）
   ============================================ */
.top-bar {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: 8rpx 0 16rpx;
}

.top-bar-left {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.top-bar-right {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.avatar-tap {
  transform: scale(0.97);
}

.date-badge {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  background: var(--color-primary-bg);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* 天气小胶囊 */
.weather-chip {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(8rpx);
}

/* 离线提示 */
.offline-tip,
.env-tip {
  padding: 16rpx 24rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  margin-bottom: 16rpx;
  text-align: center;
}

.offline-tip {
  background: rgba(232, 85, 78, 0.08);
  color: var(--color-danger);
}

.env-tip {
  background: rgba(212, 184, 150, 0.12);
  color: var(--color-primary-dark);
}

/* ============================================
   每日育娃小贴士卡（原预测卡区，适配奶咖色系）
   ============================================ */
.predict-card.tip-card {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(12rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  padding: 22rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(180, 150, 110, 0.12);
}

.tip-card-hover {
  background: rgba(212, 184, 150, 0.22);
}

.tip-card-icon {
  font-size: 44rpx;
  line-height: 1;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.tip-card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.tip-card-title {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-primary-dark);
  margin-bottom: 6rpx;
}

.tip-card-text {
  font-size: 26rpx;
  color: var(--color-text-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.tip-card-full {
  font-size: 24rpx;
  color: var(--color-text-regular, #5C4E3E);
  line-height: 1.55;
  word-break: break-all;
}

.tip-card-copy {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  background: rgba(212, 184, 150, 0.28);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.tip-copy-hover {
  background: rgba(212, 184, 150, 0.5);
}

.tip-copy-icon {
  font-size: 20rpx;
  color: var(--color-text-secondary, #8A7C6A);
  margin-right: 4rpx;
}

.tip-copy-text {
  font-size: 20rpx;
  color: var(--color-text-secondary, #8A7C6A);
}

/* ============================================
   宝宝封面相册（4:3 卡片，右上角编辑控件）
   ============================================ */
.album-card {
  position: relative;
  width: 100%;
  /* 4:3 比例：宽度撑满，高度按 3/4 计算 */
  flex-shrink: 0;
  margin-bottom: 24rpx;
}

.album-swiper {
  width: 100%;
  /* 用 aspect-ratio 实现 4:3；不支持时回退到固定高度 */
  aspect-ratio: 4 / 3;
  height: auto;
  min-height: 320rpx;
  border-radius: 32rpx;
  overflow: hidden;
}

.album-item {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(150, 120, 80, 0.18);
}

.album-img {
  width: 100%;
  height: 100%;
  transform: scale(1);
  transition: transform 6s ease;
}

/* 照片标签：左下角胶囊 */
.photo-tag {
  position: absolute;
  left: 20rpx;
  bottom: 20rpx;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8rpx);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  max-width: 60%;
}

.photo-tag-text {
  font-size: 22rpx;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 右上角编辑控件 */
.album-edit-fab {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  z-index: 2;
}

.fab-hover {
  background: rgba(0, 0, 0, 0.6);
  transform: scale(0.92);
}

.fab-icon {
  font-size: 32rpx;
  line-height: 1;
}

/* 空相册占位卡（4:3） */
.album-empty {
  width: 100%;
  aspect-ratio: 4 / 3;
  height: auto;
  min-height: 320rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 2rpx dashed var(--color-primary-light);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 上传入口卡（swiper 内） */
.album-add {
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx dashed var(--color-primary-light);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: none;
}

.album-add-hover {
  background: var(--color-primary-bg);
}

.album-add-icon {
  font-size: 64rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}

.album-add-text {
  font-size: var(--font-md);
  font-weight: 500;
  color: var(--color-text-primary);
}

.album-add-sub {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  margin-top: 8rpx;
}

/* ============================================
   记录控件：三卡一行
   ============================================ */
.record-row {
  display: flex;
  gap: 20rpx;
  flex-shrink: 0;
  margin-bottom: 20rpx;
}

.record-card {
  position: relative;
  flex: 1;
  min-width: 0;
  border-radius: 36rpx;
  padding: 36rpx 12rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.record-card.pressing {
  transform: scale(0.94);
}

/* 喂奶：暖橙 */
.feed-card {
  background: linear-gradient(150deg, #F5C6A0 0%, #E89B5F 100%);
  box-shadow: 0 12rpx 32rpx rgba(232, 155, 95, 0.32);
}

/* 换尿布：浅青 */
.diaper-card {
  background: linear-gradient(150deg, #B8D4D0 0%, #7AAFA8 100%);
  box-shadow: 0 12rpx 32rpx rgba(122, 175, 168, 0.28);
}

/* 睡觉：浅紫 */
.sleep-card {
  background: linear-gradient(150deg, #C7B8D9 0%, #8B7AAA 100%);
  box-shadow: 0 12rpx 32rpx rgba(139, 122, 170, 0.28);
}

.sleep-card.sleeping-state {
  background: linear-gradient(150deg, #A89BC9 0%, #6B5A8E 100%);
  box-shadow: 0 12rpx 32rpx rgba(107, 90, 142, 0.4);
}

.record-icon-wrap {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.record-icon {
  width: 84rpx;
  height: 84rpx;
}

.record-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
}

.card-info {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.info-row {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.3;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.info-next {
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.72);
  white-space: normal;
  text-align: center;
}

.record-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 10rpx;
}

/* 小成功标记 */
.mini-success {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(127, 176, 105, 0.95);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  z-index: 5;
  animation: checkBounce 0.4s ease;
}

@keyframes checkBounce {
  0% { transform: scale(0); }
  60% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

/* 底部提示 */
.bottom-hint {
  flex-shrink: 0;
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  padding-bottom: 16rpx;
}

/* ============================================
   弹层通用（z-index 必须 ≥ 9999，高于自定义 tabBar）
   ============================================ */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 10000;
  display: flex;
  align-items: flex-end;
  animation: maskIn 0.25s ease;
}

@keyframes maskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.sleep-sheet {
  width: 100%;
  background: var(--color-bg);
  border-radius: 40rpx 40rpx 0 0;
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  animation: sheetUp 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}

@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--color-divider);
  margin: 8rpx auto 24rpx;
}

.sleep-sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: 32rpx;
}

/* 已入睡时长展示 */
.sleep-current {
  text-align: center;
  margin-bottom: 32rpx;
  padding: 16rpx 0;
}

.sleep-current-num {
  font-size: 64rpx;
  font-weight: 200;
  color: var(--color-primary-dark);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.sleep-current-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

/* 操作按钮 */
.sleep-action-btn {
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  transition: transform 0.15s ease;
}

.sleep-action-primary {
  background: var(--color-primary);
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(212, 184, 150, 0.35);
}

.sleep-action-secondary {
  background: var(--color-bg-card);
  color: var(--color-text-primary);
  border: 1rpx solid var(--color-divider);
}

.btn-hover {
  transform: scale(0.97);
}

.sleep-cancel-link {
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-hint);
  padding: 16rpx 0;
}

/* 时长选择网格 */
.duration-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.duration-item {
  flex: 1 1 calc(25% - 16rpx);
  min-width: calc(25% - 16rpx);
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--color-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  border: 1rpx solid var(--color-divider);
  transition: transform 0.15s ease, background 0.15s ease;
}

.duration-item-hover {
  transform: scale(0.95);
  background: var(--color-primary-bg);
  color: var(--color-primary-dark);
  border-color: var(--color-primary-light);
}

/* 弹层副标题 */
.sheet-sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: 24rpx;
}

/* 喂奶量输入行 */
.amount-input-row {
  display: flex;
  align-items: center;
  background: var(--color-bg-card);
  border-radius: 20rpx;
  padding: 0 28rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(180, 150, 110, 0.06);
}

/* 喂奶量：快捷选择网格（两排胶囊） */
.feed-quick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.feed-quick-item {
  flex: 1 1 calc(25% - 16rpx);
  min-width: calc(25% - 16rpx);
  height: 88rpx;
  border-radius: 22rpx;
  background: var(--color-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  border: 1rpx solid var(--color-divider);
  font-variant-numeric: tabular-nums;
  transition: transform 0.15s ease, background 0.15s ease;
}

.feed-quick-item.active {
  background: var(--color-primary);
  color: #FFFFFF;
  border-color: var(--color-primary);
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 150, 0.35);
}

/* 自定义入口行：标签 + 输入框（点击标签后展开输入框） */
.feed-custom-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.feed-custom-tag {
  flex-shrink: 0;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 22rpx;
  background: var(--color-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-divider);
  transition: all 0.15s ease;
}

.feed-custom-tag.active {
  background: var(--color-primary);
  color: #FFFFFF;
  border-color: var(--color-primary);
}

/* 自定义输入框：复用 amount-input-row，但去掉默认下边距 */
.feed-custom-input {
  flex: 1;
  margin-bottom: 0;
}

.amount-input {
  flex: 1;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.amount-unit {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-left: 12rpx;
}

/* 尿布类型选择网格 */
.diaper-type-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.diaper-type-item {
  flex: 1;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--color-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  border: 1rpx solid var(--color-divider);
  transition: all 0.15s ease;
}

.diaper-type-item.active {
  background: var(--color-primary);
  color: #FFFFFF;
  border-color: var(--color-primary);
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 150, 0.35);
}

/* ============================================
   顶部用户信息条详细样式
   ============================================ */
.user-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #F0E6D4;
  box-shadow: 0 4rpx 12rpx rgba(180, 150, 110, 0.18);
}

.user-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.user-text {
  margin-left: 18rpx;
  min-width: 0;
  overflow: hidden;
  flex: 1;
}

/* 第一行：昵称 + 共N个宝宝 */
.user-nickname-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  overflow: hidden;
}

.user-nickname {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 0;
  max-width: 240rpx;
}

.user-count {
  font-size: 22rpx;
  color: var(--color-text-hint);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 第二行：宝宝：XXX ▾ 切换入口 */
.baby-switch-row {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
  gap: 4rpx;
}

.baby-switch-label {
  font-size: 24rpx;
  color: var(--color-text-hint);
  flex-shrink: 0;
}

.baby-switch-name {
  font-size: 26rpx;
  color: var(--color-primary-dark, #B8966C);
  font-weight: 600;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.baby-switch-trigger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(212, 184, 150, 0.15);
  margin-left: 4rpx;
}

.baby-switch-arrow {
  font-size: 20rpx;
  color: var(--color-primary-dark, #B8966C);
  line-height: 1;
  margin-top: -4rpx;
}

/* 当前宝宝卡片：标题行升级版 */
.header {
  padding: 12rpx 0 20rpx;
  position: relative;
}

.baby-avatar {
  position: relative;
}

.baby-switch-icon {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 2rpx solid var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
}

.baby-id-chip {
  font-size: 20rpx;
  color: var(--color-text-hint);
  background: rgba(255, 255, 255, 0.7);
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  letter-spacing: 1rpx;
}

/* ============================================
   宝宝管理面板
   ============================================ */
.baby-panel-mask {
  z-index: 10001;
}

.baby-panel {
  background: #FAF6F0;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 40rpx);
  max-height: 86vh;
  overflow-y: auto;
}

.baby-panel-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 24rpx;
  text-align: center;
}

.baby-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.baby-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s ease;
}

.baby-item.active {
  border-color: var(--color-primary);
  background: #FBF5EB;
}

.baby-item-hover {
  background: #F5EEDC;
}

.baby-item-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #F0E6D4;
}

.baby-item-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.baby-item-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.baby-item-name {
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.baby-item-id {
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}

.baby-item-check {
  color: var(--color-primary);
  font-size: 36rpx;
  font-weight: 700;
  margin-left: 12rpx;
}

.baby-item-edit {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: #F0E6D4;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
}

.baby-item-delete {
  font-size: 24rpx;
  color: #E8554E;
  background: #FBE9E7;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
}

.baby-empty {
  text-align: center;
  color: var(--color-text-hint);
  font-size: 26rpx;
  padding: 60rpx 0;
}

.baby-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.baby-action-btn {
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
  border: 2rpx dashed rgba(212, 184, 150, 0.6);
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

/* 表单 */
.baby-form {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
  text-align: center;
}

.form-avatar-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.form-avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  background: #F0E6D4;
  border-radius: 50%;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.form-avatar-btn::after {
  border: none;
}

.form-avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.form-avatar-placeholder {
  font-size: 48rpx;
}

.form-tip {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.form-input {
  width: 100%;
  height: 96rpx;
  background: #FAF6F0;
  border-radius: 20rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

.form-row-inline {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.form-picker {
  background: #FAF6F0;
  border-radius: 20rpx;
  padding: 0 28rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.form-gender-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-right: 16rpx;
}

.form-gender-options {
  display: flex;
  gap: 16rpx;
  flex: 1;
}

.form-gender-opt {
  flex: 1;
  height: 72rpx;
  border-radius: 20rpx;
  background: #FAF6F0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  border: 2rpx solid transparent;
}

.form-gender-opt.active {
  background: var(--color-primary);
  color: #FFFFFF;
  border-color: var(--color-primary);
}

.form-tip-block {
  background: #FBF5EB;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.form-cancel {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  background: #F0E6D4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--color-text-secondary);
}

.form-submit {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.form-submit-full {
  flex: 1;
}

.success-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  font-size: 30rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.success-label {
  color: var(--color-text-secondary);
  width: 180rpx;
}

.success-value {
  flex: 1;
  color: var(--color-text-primary);
  font-weight: 600;
  letter-spacing: 2rpx;
  font-family: monospace;
}

/* 登出 */
.logout-row {
  margin-bottom: 16rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: #FFF0EE;
  color: #E8554E;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

/* ============================================
   照片编辑面板
   ============================================ */
.photo-edit-mask {
  z-index: 10001;
}

.photo-edit-panel {
  background: #FAF6F0;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 40rpx);
  max-height: 88vh;
  overflow-y: auto;
}

.photo-edit-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 24rpx;
  text-align: center;
}

.photo-edit-preview {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(150, 120, 80, 0.18);
}

.photo-edit-img {
  width: 100%;
  height: 100%;
}

.photo-edit-pos {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.photo-edit-section {
  margin-bottom: 24rpx;
}

.photo-edit-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.tag-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-option {
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  border: 2rpx solid transparent;
}

.tag-option.active {
  background: var(--color-primary);
  color: #FFFFFF;
  border-color: var(--color-primary);
}

.photo-edit-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.photo-edit-btn {
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-primary);
}

.photo-edit-btn-danger {
  color: #E8554E;
  background: #FFF0EE;
}

.photo-edit-save {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

/* ============================================
   上传/替换照片裁剪面板（固定 4:3）
   ============================================ */
.photo-crop-mask {
  z-index: 10002;
}

.photo-crop-panel {
  background: #FAF6F0;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 40rpx);
}

.photo-crop-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: 8rpx;
}

.photo-crop-sub {
  font-size: 24rpx;
  color: var(--color-text-hint);
  text-align: center;
  margin-bottom: 24rpx;
}

.photo-crop-stage {
  position: relative;
  width: 100%;
  margin: 0 auto 16rpx;
  border-radius: 24rpx;
  background: #000;
  overflow: hidden;
}

.photo-crop-img {
  position: absolute;
  max-width: none;
}

/* 固定 4:3 裁剪框遮罩：中心区域透明，四周暗化 */
.photo-crop-frame {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  box-shadow: 0 0 0 2000rpx rgba(0, 0, 0, 0.55);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 8rpx;
  pointer-events: none;
}

/* 参考线 */
.photo-crop-grid-v {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 33.33%;
  width: 2rpx;
  background: rgba(255, 255, 255, 0.25);
  z-index: 3;
  pointer-events: none;
}

.photo-crop-grid-h {
  position: absolute;
  top: 33.33%;
  left: 0;
  right: 0;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.25);
  z-index: 3;
  pointer-events: none;
}

.photo-crop-tip {
  font-size: 22rpx;
  color: var(--color-text-hint);
  text-align: center;
  margin-bottom: 24rpx;
}

.photo-crop-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.photo-crop-cancel {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  background: #F0E6D4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--color-text-secondary);
}

.photo-crop-confirm {
  flex: 1.4;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

/* 隐藏 canvas（裁剪导出） */
.crop-canvas-hidden {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 800px;
  height: 600px;
}
