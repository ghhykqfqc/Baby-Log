/* pages/index/index.wxss - 首页 */

.page-index {
  min-height: 100vh;
  padding: 32rpx 32rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 顶部 */
.header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.baby-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 24rpx;
}

.baby-info {
  flex: 1;
}

.baby-name {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.baby-meta {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.date-badge {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  background: var(--color-primary-bg);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* 离线提示 */
.offline-tip {
  background: rgba(232, 85, 78, 0.08);
  color: var(--color-danger);
  padding: 16rpx 24rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  margin-bottom: 16rpx;
  text-align: center;
}

/* 预测区 */
.prediction-area {
  margin-bottom: 48rpx;
}

.predict-card {
  background: var(--color-primary-bg);
  border-radius: var(--radius-sm);
  padding: 16rpx 24rpx;
  margin-bottom: 12rpx;
}

.predict-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

/* 按钮区 */
.buttons-area {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: flex-start;
  padding: 48rpx 0 120rpx;
  gap: 24rpx;
}

/* 底部提示 */
.bottom-hint {
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  padding-bottom: 40rpx;
}
