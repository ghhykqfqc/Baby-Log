/* pages/index/index.wxss - 首页（差异化布局重构） */

.page-index {
  min-height: 100vh;
  padding: 32rpx 32rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* ===== 顶部 ===== */
.header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.baby-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
  transition: transform 0.15s ease;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-emoji {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-tap {
  transform: scale(0.94);
}

.baby-info {
  flex: 1;
}

.baby-name {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.baby-meta {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.date-badge {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  background: var(--color-primary-bg);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* 离线提示 */
.offline-tip,
.env-tip {
  padding: 16rpx 24rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  margin-bottom: 16rpx;
  text-align: center;
}

.offline-tip {
  background: rgba(232, 85, 78, 0.08);
  color: var(--color-danger);
}

.env-tip {
  background: rgba(212, 184, 150, 0.12);
  color: var(--color-primary-dark);
}

/* ===== 预测胶囊 ===== */
.prediction-area {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.predict-pill {
  display: inline-flex;
  align-items: center;
  background: var(--color-primary-bg);
  border-radius: 32rpx;
  padding: 10rpx 22rpx;
}

.pill-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.pill-text {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* ============================================
   主操作区 - 差异化布局
   ============================================ */

/* ===== 喂奶大卡片（视觉中心，最高频） ===== */
.feed-card {
  position: relative;
  background: linear-gradient(135deg, #F5C6A0 0%, #E89B5F 100%);
  border-radius: 48rpx;
  padding: 56rpx 32rpx 48rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(232, 155, 95, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.feed-card.pressing {
  transform: scale(0.96);
  box-shadow: 0 8rpx 24rpx rgba(232, 155, 95, 0.3);
}

.feed-icon-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

/* 光晕 */
.feed-glow {
  position: absolute;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  animation: glowPulse 3s ease-in-out infinite;
}

@keyframes glowPulse {
  0%, 100% { transform: scale(1); opacity: 0.15; }
  50% { transform: scale(1.1); opacity: 0.3; }
}

.feed-icon {
  position: relative;
  z-index: 2;
  width: 140rpx;
  height: 140rpx;
}

.feed-label {
  font-size: 44rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(232, 155, 95, 0.4);
}

/* 卡片信息区（距上次 + 预计下次） */
.card-info {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.info-row {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
}

.info-next {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.feed-hint {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 12rpx;
}

/* 成功遮罩 */
.success-overlay {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10;
  animation: fadeHold 1s ease forwards;
}

@keyframes fadeHold {
  0%, 60% { opacity: 1; }
  100% { opacity: 0; }
}

.success-check {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #7FB069;
  color: #FFFFFF;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  animation: checkBounce 0.4s ease;
}

@keyframes checkBounce {
  0% { transform: scale(0); }
  60% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

.success-label {
  font-size: 32rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

/* ===== 下方双卡片区 ===== */
.dual-area {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.dual-card {
  position: relative;
  flex: 1;
  border-radius: 36rpx;
  padding: 36rpx 20rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.dual-card.pressing {
  transform: scale(0.95);
}

/* 换尿布：浅青色 */
.diaper-card {
  background: linear-gradient(135deg, #B8D4D0 0%, #7AAFA8 100%);
  box-shadow: 0 12rpx 32rpx rgba(122, 175, 168, 0.3);
}

/* 睡觉：浅紫 */
.sleep-card {
  background: linear-gradient(135deg, #C7B8D9 0%, #8B7AAA 100%);
  box-shadow: 0 12rpx 32rpx rgba(139, 122, 170, 0.3);
}

.dual-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.dual-icon {
  width: 88rpx;
  height: 88rpx;
}

.dual-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

/* dual 卡片（尿布/睡觉）的双行文案微调：更紧凑 */
.dual-card .card-info {
  margin-top: 10rpx;
  gap: 4rpx;
}

.dual-card .info-row {
  font-size: 22rpx;
  line-height: 1.3;
}

.dual-card .info-next {
  font-size: 20rpx;
}

.dual-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
}

/* 小成功标记 */
.mini-success {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(127, 176, 105, 0.95);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  z-index: 5;
  animation: checkBounce 0.4s ease;
}

/* 底部提示 */
.bottom-hint {
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  padding-bottom: 40rpx;
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* ===== 睡眠状态样式 ===== */
.sleep-card.sleeping-state {
  background: linear-gradient(135deg, #A89BC9 0%, #6B5A8E 100%);
  box-shadow: 0 12rpx 32rpx rgba(107, 90, 142, 0.4);
}

/* ===== 弹层通用 ===== */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 9999;            /* 必须高于自定义 tabBar 的 1000 */
  display: flex;
  align-items: flex-end;
  animation: maskIn 0.25s ease;
}

@keyframes maskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.sleep-sheet {
  width: 100%;
  background: var(--color-bg);
  border-radius: 40rpx 40rpx 0 0;
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  animation: sheetUp 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}

@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--color-divider);
  margin: 8rpx auto 24rpx;
}

.sleep-sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: 32rpx;
}

/* 已入睡时长展示 */
.sleep-current {
  text-align: center;
  margin-bottom: 32rpx;
  padding: 16rpx 0;
}

.sleep-current-num {
  font-size: 64rpx;
  font-weight: 200;
  color: var(--color-primary-dark);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.sleep-current-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

/* 操作按钮 */
.sleep-action-btn {
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  transition: transform 0.15s ease;
}

.sleep-action-primary {
  background: var(--color-primary);
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(212, 184, 150, 0.35);
}

.sleep-action-secondary {
  background: var(--color-bg-card);
  color: var(--color-text-primary);
  border: 1rpx solid var(--color-divider);
}

.btn-hover {
  transform: scale(0.97);
}

.sleep-cancel-link {
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-hint);
  padding: 16rpx 0;
}

/* 时长选择网格 */
.duration-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.duration-item {
  flex: 1 1 calc(25% - 16rpx);
  min-width: calc(25% - 16rpx);
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--color-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  border: 1rpx solid var(--color-divider);
  transition: transform 0.15s ease, background 0.15s ease;
}

.duration-item-hover {
  transform: scale(0.95);
  background: var(--color-primary-bg);
  color: var(--color-primary-dark);
  border-color: var(--color-primary-light);
}
