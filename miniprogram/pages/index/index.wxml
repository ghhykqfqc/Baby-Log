<!-- pages/index/index.wxml - 首页（天气皮肤 + 云朵AI育娃伙伴 + 单行记录）
     2026-09-12 改造：原「照片轮播相册」整块移除（规避 UGC 图片审核风险），
     替换为「云朵 AI 育娃伙伴」：按住说话 / 点按文本提问 → 云函数调 DeepSeek → 打字机字幕 → TTS 播报 -->
<view class="page-index safe-bottom">

  <!-- ===== 天气皮肤背景层（纯装饰，最底层） ===== -->
  <view class="weather-bg wx-{{weatherClass}}">
    <block wx:if="{{weatherClass === 'sunny'}}">
      <view class="sun-glow"></view>
      <view class="cloud cloud-1"></view>
      <view class="cloud cloud-2"></view>
      <view class="cloud cloud-3"></view>
    </block>
    <block wx:if="{{weatherClass === 'cloudy'}}">
      <view class="cloud cloud-1 cloud-dim"></view>
      <view class="cloud cloud-2 cloud-dim"></view>
    </block>
    <block wx:if="{{weatherClass === 'rain'}}">
      <view class="glass-mist"></view>
      <canvas
        type="2d"
        id="rainCanvas"
        class="rain-canvas"
        wx:if="{{!showFeedSheet && !showDiaperSheet && !showSleepSheet && !showBabySheet && !showAiTextSheet && !showAiAnswerPanel && !showLoginPanel}}"
      ></canvas>
    </block>
    <block wx:if="{{weatherClass === 'snow'}}">
      <view class="snow-layer"></view>
    </block>
    <block wx:if="{{weatherClass === 'wind'}}">
      <view class="leaf leaf-1">🍂</view>
      <view class="leaf leaf-2">🍃</view>
      <view class="leaf leaf-3">🍁</view>
      <view class="leaf leaf-4">🍃</view>
      <view class="leaf leaf-5">🍂</view>
    </block>
  </view>

  <!-- ===== 页面内容层 ===== -->
  <view class="content-layer">

    <!-- ========== 顶部统一信息条 ========== -->
    <view class="top-bar">
      <view class="top-bar-left" bindtap="showBabyPanel" hover-class="avatar-tap" hover-stay-time="80">
        <image wx:if="{{userInfo.avatarUrl}}" class="user-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="user-avatar user-avatar-default">👤</view>
        <view class="user-text">
          <view class="user-nickname-row">
            <text class="user-nickname">{{userInfo.nickName || '游客'}}</text>
            <text class="user-login-tip" wx:if="{{!userInfo.openid}}">· 登录享永久保存</text>
            <text class="user-count" wx:elif="{{babies.length > 0}}">· 共{{babies.length}}个宝宝</text>
          </view>
          <view class="baby-switch-row">
            <text class="baby-switch-label">宝宝：</text>
            <text class="baby-switch-name">{{babyInfo.name || '点此添加'}}</text>
            <view class="baby-switch-trigger">
              <text class="baby-switch-arrow">▾</text>
            </view>
          </view>
        </view>
      </view>
      <view class="top-bar-right">
        <view class="weather-chip" wx:if="{{weatherText}}">{{weatherText}}</view>
        <view class="date-badge" wx:else>{{todayText}}</view>
      </view>
    </view>

    <!-- 网络状态提示 -->
    <view class="offline-tip" wx:if="{{isOffline}}">
      <text>📴 当前离线，记录已保存本地，联网后自动同步</text>
    </view>

    <!-- 云开发未就绪提示（仅开发期） -->
    <view class="env-tip" wx:if="{{!cloudReady}}">
      <text>🔧 云开发未开通，当前为离线模式。记录会保存到本地，开通云环境后自动同步。</text>
    </view>

    <!-- ===== 每日育娃小贴士卡 ===== -->
    <view class="predict-card tip-card" bindtap="showDailyTip" hover-class="tip-card-hover" hover-stay-time="80">
      <view class="tip-card-icon">💡</view>
      <view class="tip-card-body">
        <view class="tip-card-title">每日育娃小贴士</view>
        <view class="tip-card-text" wx:if="{{!showTipFull}}">{{dailyTipShort}}</view>
        <view class="tip-card-full" wx:else>{{dailyTipFull}}</view>
      </view>
      <view class="tip-card-copy" catchtap="copyDailyTip" hover-class="tip-copy-hover" hover-stay-time="60">
        <text class="tip-copy-icon">⧉</text>
        <text class="tip-copy-text">复制</text>
      </view>
    </view>

    <!-- ========== 云朵 AI 育娃伙伴（原照片轮播区位置 · 弹性布局加高） ========== -->
    <view class="ai-buddy-card">
      <!-- 快捷提问气泡（横向滚动） -->
      <scroll-view class="ai-quick-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="ai-quick-row">
          <view
            class="ai-quick-bubble"
            wx:for="{{quickQuestions}}" wx:key="*this"
            data-text="{{item}}"
            bindtap="onQuickQuestion"
            hover-class="ai-quick-hover"
          >{{item}}</view>
        </view>
      </scroll-view>

      <!-- AI 主区：语音大按钮（大而居中）+ 字幕 -->
      <view class="ai-main">
        <!-- 顶部状态：听 / 想 / 播 -->
        <view class="ai-status-row">
          <text wx:if="{{aiListening}}" class="ai-status-text ai-status-listening">正在聆听…</text>
          <text wx:elif="{{aiThinking}}" class="ai-status-text ai-status-thinking">小云朵思考中…</text>
          <text wx:elif="{{aiSpeaking && !aiTalking}}" class="ai-status-text ai-status-speaking">正在播报…</text>
          <text wx:else class="ai-status-text ai-status-idle">按住说话，或点一下问问育儿问题</text>
        </view>

        <!-- 语音工作区（大按钮，居中） -->
        <view class="ai-voice-zone">
          <!-- 声波指示条（按住说话 / 播放中显示），纯 CSS 动画 -->
          <view class="ai-wave {{aiWaveActive ? 'active' : ''}}" wx:if="{{aiWaveActive}}">
            <view class="ai-wave-bar b1"></view>
            <view class="ai-wave-bar b2"></view>
            <view class="ai-wave-bar b3"></view>
            <view class="ai-wave-bar b4"></view>
            <view class="ai-wave-bar b5"></view>
          </view>

          <!-- 大语音按钮（按住说话 / 单击输入） -->
          <view
            class="ai-voice-btn {{aiTalking ? 'talking' : ''}} {{aiListening ? 'listening' : ''}}"
            bindtouchstart="onCloudTouchStart"
            bindtouchend="onCloudTouchEnd"
            bindtouchcancel="onCloudTouchCancel"
            bindlongpress="onCloudLongPress"
            bindtap="onCloudTap"
            hover-class="none"
          >
            <svg class="ai-mic-svg" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <!-- 麦克风主体：圆角胶囊 -->
              <path d="M13.5 7c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5v7c0 1.38-1.12 2.5-2.5 2.5s-2.5-1.12-2.5-2.5V7z" fill="currentColor" opacity="0.95"/>
              <!-- 麦克风座（弧形拾音区） -->
              <path d="M9.5 14.5c0 3.6 2.83 6.55 6.5 6.55s6.5-2.95 6.5-6.55c0-.55.45-1 1-1s1 .45 1 1c0 4.5-3.42 8.2-7.5 8.92V26h4c.55 0 1 .45 1 1s-.45 1-1 1h-10c-.55 0-1-.45-1-1s.45-1 1-1h4v-2.58c-4.08-.72-7.5-4.42-7.5-8.92 0-.55.45-1 1-1s1 .45 1 1z" fill="currentColor" opacity="0.85"/>
              <!-- 右侧装饰声波短竖线 -->
              <path d="M23 11.5c.55 0 1 .45 1 1v2c0 .55-.45 1-1 1s-1-.45-1-1v-2c0-.55.45-1 1-1z" fill="currentColor" opacity="0.65"/>
            </svg>
          </view>

          <view class="ai-voice-tip">{{aiTipText}}</view>
        </view>

        <!-- 流式字幕区（多行自适应，可滚动，点击展开完整回答） -->
        <view class="ai-subtitle-bar" bindtap="showFullAnswer">
          <scroll-view class="ai-subtitle-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
            <view class="ai-subtitle-text">
              <text wx:if="{{aiSubtitle}}">{{aiSubtitle}}</text>
              <text wx:elif="{{aiThinking}}" class="ai-thinking">小云朵思考中</text>
              <text wx:else class="ai-subtitle-placeholder">点击展开完整回答</text>
            </view>
          </scroll-view>
          <view class="ai-subtitle-arrow" wx:if="{{aiShowArrow}}">
            <text>∨</text>
            <text class="ai-subtitle-expand-tip">全文</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 记录控件：三卡一行 ===== -->
    <view class="record-row">
      <view
        class="record-card feed-card {{feedPress ? 'pressing' : ''}}"
        bindtap="handleFeed"
        bindlongpress="showFeedSheet"
        hover-class="none"
      >
        <view class="mini-success" wx:if="{{feedSuccess}}"><text>✓</text></view>
        <view class="record-icon-wrap">
          <image class="record-icon" src="/images/icons/bottle.svg" mode="aspectFit"></image>
        </view>
        <view class="record-label">喂奶</view>
        <view class="card-info" wx:if="{{cardTexts.feed.elapsed !== '--'}}">
          <view class="info-row">{{cardTexts.feed.elapsed}}</view>
          <view class="info-row info-next" wx:if="{{cardTexts.feed.next}}">{{cardTexts.feed.next}}</view>
        </view>
        <view class="record-hint" wx:else>点击记录 · 长按填量</view>
      </view>

      <view
        class="record-card diaper-card {{diaperPress ? 'pressing' : ''}}"
        bindtap="handleDiaper"
        bindlongpress="showDiaperSheet"
        hover-class="none"
      >
        <view class="mini-success" wx:if="{{diaperSuccess}}"><text>✓</text></view>
        <view class="record-icon-wrap">
          <image class="record-icon" src="/images/icons/diaper.svg" mode="aspectFit"></image>
        </view>
        <view class="record-label">尿布</view>
        <view class="card-info" wx:if="{{cardTexts.diaper.elapsed !== '--'}}">
          <view class="info-row">{{cardTexts.diaper.elapsed}}</view>
          <view class="info-row info-next" wx:if="{{cardTexts.diaper.next}}">{{cardTexts.diaper.next}}</view>
        </view>
        <view class="record-hint" wx:else>点击记录</view>
      </view>

      <view
        class="record-card sleep-card {{sleepPress ? 'pressing' : ''}} {{sleeping ? 'sleeping-state' : ''}}"
        bindtap="handleSleepTap"
        bindlongpress="showSleepSheet"
        hover-class="none"
      >
        <view class="mini-success" wx:if="{{sleepSuccess}}"><text>✓</text></view>
        <view class="record-icon-wrap">
          <image class="record-icon" src="/images/icons/moon.svg" mode="aspectFit"></image>
        </view>
        <view class="record-label">{{sleeping ? '已入睡' : '睡觉'}}</view>
        <view class="card-info" wx:if="{{cardTexts.sleep.elapsed && cardTexts.sleep.elapsed !== '--'}}">
          <view class="info-row">{{cardTexts.sleep.elapsed}}</view>
          <view class="info-row info-next" wx:if="{{cardTexts.sleep.next}}">{{cardTexts.sleep.next}}</view>
        </view>
        <view class="record-hint" wx:else>点击记录 · 长按回忆</view>
      </view>
    </view>

    <!-- 底部小提示 -->
    <view class="bottom-hint">
      <text>👆 单击即记 · 长按填详情</text>
    </view>
  </view>

  <!-- ========== 喂奶量弹层（长按触发） ========== -->
  <view class="sheet-mask" wx:if="{{showFeedSheet}}" bindtap="hideFeedSheet" catchtouchmove="noop">
    <view class="sleep-sheet" catchtap="noop">
      <view class="sheet-handle" data-close="hideFeedSheet" bindtouchstart="_onSheetTouchStart" bindtouchmove="_onSheetTouchMove" bindtouchend="_onSheetTouchEnd"></view>
      <view class="sleep-sheet-title">记录喂奶</view>
      <view class="sheet-sub">选择常见喂奶量，或点「自定义」输入具体数值</view>

      <view class="feed-quick-grid">
        <view
          class="feed-quick-item {{feedQuickAmount === item && !feedCustomMode ? 'active' : ''}}"
          wx:for="{{feedQuickOptions}}" wx:key="*this"
          data-amount="{{item}}"
          bindtap="selectFeedQuick"
          hover-class="duration-item-hover"
        >{{item}}ml</view>
      </view>

      <view class="feed-custom-row">
        <view
          class="feed-custom-tag {{feedCustomMode ? 'active' : ''}}"
          bindtap="enableFeedCustom"
          hover-class="duration-item-hover"
        >✏️ 自定义</view>
        <block wx:if="{{feedCustomMode}}">
          <view class="amount-input-row feed-custom-input">
            <input class="amount-input" type="digit" placeholder="如 125" value="{{feedAmountInput}}" bindinput="onFeedAmountInput" confirm-type="done" bindconfirm="saveFeedWithAmount" focus="{{true}}" />
            <text class="amount-unit">ml</text>
          </view>
        </block>
      </view>

      <view class="sleep-action-btn sleep-action-primary" bindtap="saveFeedWithAmount" hover-class="btn-hover">
        💾 保存
      </view>
      <view class="sleep-cancel-link" bindtap="hideFeedSheet">取消</view>
    </view>
  </view>

  <!-- ========== 尿布类型弹层（长按触发） ========== -->
  <view class="sheet-mask" wx:if="{{showDiaperSheet}}" bindtap="hideDiaperSheet" catchtouchmove="noop">
    <view class="sleep-sheet" catchtap="noop">
      <view class="sheet-handle" data-close="hideDiaperSheet" bindtouchstart="_onSheetTouchStart" bindtouchmove="_onSheetTouchMove" bindtouchend="_onSheetTouchEnd"></view>
      <view class="sleep-sheet-title">记录换尿布</view>
      <view class="sheet-sub">选择类型，不选也可记录时间点</view>
      <view class="diaper-type-grid">
        <view class="diaper-type-item {{diaperTypeInput === 'pee' ? 'active' : ''}}" data-type="pee" bindtap="selectDiaperType" hover-class="duration-item-hover">💦 小便</view>
        <view class="diaper-type-item {{diaperTypeInput === 'poop' ? 'active' : ''}}" data-type="poop" bindtap="selectDiaperType" hover-class="duration-item-hover">💩 大便</view>
        <view class="diaper-type-item {{diaperTypeInput === 'loose' ? 'active' : ''}}" data-type="loose" bindtap="selectDiaperType" hover-class="duration-item-hover">🤢 拉稀</view>
      </view>
      <view class="sleep-action-btn sleep-action-primary" bindtap="saveDiaperWithType" hover-class="btn-hover">
        💾 保存
      </view>
      <view class="sleep-cancel-link" bindtap="hideDiaperSheet">取消</view>
    </view>
  </view>

  <!-- ========== 睡眠回忆记录弹层（长按触发） ========== -->
  <view class="sheet-mask" wx:if="{{showSleepSheet}}" bindtap="hideSleepSheet" catchtouchmove="noop">
    <view class="sleep-sheet" catchtap="noop">
      <view class="sheet-handle" data-close="hideSleepSheet" bindtouchstart="_onSheetTouchStart" bindtouchmove="_onSheetTouchMove" bindtouchend="_onSheetTouchEnd"></view>
      <view class="sleep-sheet-title">回忆记录睡眠</view>
      <view class="sheet-sub">选择刚刚结束的睡眠时长</view>
      <view class="duration-grid">
        <view class="duration-item" data-minutes="30" bindtap="selectDuration" hover-class="duration-item-hover">30分钟</view>
        <view class="duration-item" data-minutes="60" bindtap="selectDuration" hover-class="duration-item-hover">1小时</view>
        <view class="duration-item" data-minutes="90" bindtap="selectDuration" hover-class="duration-item-hover">1.5小时</view>
        <view class="duration-item" data-minutes="120" bindtap="selectDuration" hover-class="duration-item-hover">2小时</view>
        <view class="duration-item" data-minutes="150" bindtap="selectDuration" hover-class="duration-item-hover">2.5小时</view>
        <view class="duration-item" data-minutes="180" bindtap="selectDuration" hover-class="duration-item-hover">3小时</view>
        <view class="duration-item" data-minutes="240" bindtap="selectDuration" hover-class="duration-item-hover">4小时</view>
        <view class="duration-item" data-minutes="480" bindtap="selectDuration" hover-class="duration-item-hover">8小时</view>
      </view>
      <view class="sleep-cancel-link" bindtap="hideSleepSheet">取消</view>
    </view>
  </view>

  <!-- ========== 云朵 AI：文本输入弹层（点按云朵触发） ========== -->
  <view class="sheet-mask ai-sheet-mask" wx:if="{{showAiSheet}}" bindtap="hideAiSheet" catchtouchmove="noop">
    <view class="ai-input-sheet" catchtap="noop">
      <view class="sheet-handle" data-close="hideAiSheet" bindtouchstart="_onSheetTouchStart" bindtouchmove="_onSheetTouchMove" bindtouchend="_onSheetTouchEnd"></view>
      <view class="ai-input-title">问问小云朵☁️</view>
      <view class="ai-input-sub">{{aiSheetSub}}</view>

      <view class="ai-input-row">
        <input
          class="ai-input-field"
          value="{{aiInputValue}}"
          bindinput="onAiInput"
          placeholder="问点育儿问题…"
          placeholder-class="ai-input-ph"
          confirm-type="send"
          bindconfirm="submitAiFromInput"
          focus="{{aiInputFocus}}"
          maxlength="300"
        />
        <view class="ai-input-send {{aiInputValue ? 'active' : ''}}" bindtap="submitAiFromInput" hover-class="btn-hover">发送</view>
      </view>
      <view class="ai-input-tip">也可以长按首页云朵直接说话</view>
    </view>
  </view>

  <!-- ========== 云朵 AI：完整回答半屏卡片（点字幕 ∨ 展开） ========== -->
  <view class="sheet-mask ai-answer-mask" wx:if="{{showAiAnswerPanel}}" bindtap="hideAiAnswer" catchtouchmove="noop">
    <view class="ai-answer-panel" catchtap="noop">
      <view class="sheet-handle" data-close="hideAiAnswer" bindtouchstart="_onSheetTouchStart" bindtouchmove="_onSheetTouchMove" bindtouchend="_onSheetTouchEnd"></view>
      <view class="ai-answer-header">
        <text class="ai-answer-title">小云朵的回答</text>
        <view class="ai-answer-btns">
          <view class="ai-answer-btn" bindtap="speakAnswer" hover-class="btn-hover">{{aiSpeaking ? '停止' : '🔊 播报'}}</view>
          <view class="ai-answer-btn" bindtap="copyAnswer" hover-class="btn-hover">复制</view>
        </view>
      </view>
      <scroll-view class="ai-answer-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="ai-answer-content">{{aiFullAnswer}}</view>
      </scroll-view>
      <view class="ai-answer-meta">内容由 AI 生成，仅供参考</view>
    </view>
  </view>

  <!-- ========== 宝宝管理面板 ========== -->
  <view class="sheet-mask baby-panel-mask" wx:if="{{showBabySheet}}" bindtap="hideBabyPanel" catchtouchmove="noop">
    <view class="baby-panel" catchtap="noop">
      <view class="sheet-handle" data-close="hideBabyPanel" bindtouchstart="_onSheetTouchStart" bindtouchmove="_onSheetTouchMove" bindtouchend="_onSheetTouchEnd"></view>
      <view class="baby-panel-title">我的宝宝</view>

      <view class="baby-list">
        <view
          class="baby-item {{item.babyId === currentBabyId ? 'active' : ''}}"
          wx:for="{{babies}}" wx:key="babyId"
          data-baby-id="{{item.babyId}}"
          bindtap="switchBaby"
          hover-class="baby-item-hover"
        >
          <image wx:if="{{item.avatar}}" class="baby-item-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
          <view wx:else class="baby-item-avatar baby-item-avatar-default">👶</view>
          <view class="baby-item-info">
            <view class="baby-item-name">{{item.name || '未命名'}}</view>
            <view class="baby-item-id">ID: {{item.babyId}}</view>
          </view>
          <view class="baby-item-check" wx:if="{{item.babyId === currentBabyId}}">✓</view>
          <view class="baby-item-edit" data-baby-id="{{item.babyId}}" catchtap="editBaby">编辑</view>
          <view class="baby-item-delete" wx:if="{{item.isOwner}}" data-baby-id="{{item.babyId}}" data-name="{{item.name || ''}}" catchtap="deleteBaby">删除</view>
        </view>

        <view class="baby-empty" wx:if="{{babies.length === 0}}">还没有宝宝，点击下方按钮添加一个吧</view>
      </view>

      <view class="baby-actions">
        <view class="baby-action-btn" bindtap="startCreateBaby" hover-class="btn-hover">
          <view class="action-icon">＋</view>
          <view>新建宝宝</view>
        </view>
        <view class="baby-action-btn" bindtap="startJoinBaby" hover-class="btn-hover">
          <view class="action-icon">🔗</view>
          <view>用 ID 加入</view>
        </view>
      </view>

      <!-- 新建宝宝表单 -->
      <view class="baby-form" wx:if="{{formMode === 'create'}}">
        <view class="form-title">新建宝宝</view>
        <view class="form-avatar-row">
          <button class="form-avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onFormChooseAvatar" disabled="{{formAvatarAuditing}}" hover-class="btn-hover">
            <image wx:if="{{formAvatar && !formAvatarAuditing}}" class="form-avatar-img" src="{{formAvatar}}" mode="aspectFill"></image>
            <view wx:else class="form-avatar-placeholder {{formAvatarAuditing ? 'auditing' : ''}}">
              {{formAvatarAuditing ? '审核中…' : '📷'}}
            </view>
          </button>
          <view class="form-tip">{{formAvatarAuditing ? '新头像安全检测中…' : '点击选择宝宝照片（需安全检测）'}}</view>
        </view>
        <input class="form-input" placeholder="宝宝昵称" value="{{formName}}" bindinput="onFormNameInput" maxlength="20" />
        <view class="form-row-inline">
          <picker mode="date" value="{{formBirthDate}}" bindchange="onFormBirthChange">
            <view class="form-picker">🎂 生日：{{formBirthDate || '请选择'}}</view>
          </picker>
        </view>
        <view class="form-row-inline">
          <view class="form-gender-label">性别：</view>
          <view class="form-gender-options">
            <view class="form-gender-opt {{formGender === 'male' ? 'active' : ''}}" data-gender="male" bindtap="onFormGenderTap">👦 男</view>
            <view class="form-gender-opt {{formGender === 'female' ? 'active' : ''}}" data-gender="female" bindtap="onFormGenderTap">👧 女</view>
          </view>
        </view>
        <view class="form-actions">
          <view class="form-cancel" bindtap="cancelForm">取消</view>
          <view class="form-submit" bindtap="submitCreateBaby" hover-class="btn-hover">创建</view>
        </view>
      </view>

      <!-- 加入宝宝表单 -->
      <view class="baby-form" wx:if="{{formMode === 'join'}}">
        <view class="form-title">用宝宝 ID 加入</view>
        <view class="form-tip-block">请向家人索要宝宝 ID 和 6 位加入密码，加入后可与家人共享宝宝记录。</view>
        <input class="form-input" placeholder="宝宝 ID（8 位字母数字）" value="{{joinBabyId}}" bindinput="onJoinBabyIdInput" maxlength="8" />
        <input class="form-input" placeholder="6 位加入密码" password="{{true}}" value="{{joinBabyCode}}" bindinput="onJoinBabyCodeInput" maxlength="6" type="number" />
        <view class="form-actions">
          <view class="form-cancel" bindtap="cancelForm">取消</view>
          <view class="form-submit" bindtap="submitJoinBaby" hover-class="btn-hover">加入</view>
        </view>
      </view>

      <!-- 创建成功展示 ID/密码 -->
      <view class="baby-form" wx:if="{{formMode === 'success'}}">
        <view class="form-title">🎉 宝宝已创建</view>
        <view class="form-tip-block">把下面的 ID 和密码分享给家人，他们就可以加入并一起记录啦！</view>
        <view class="success-row">
          <text class="success-label">宝宝 ID：</text>
          <text class="success-value" selectable="{{true}}" user-select="{{true}}">{{newBabyId}}</text>
        </view>
        <view class="success-row">
          <text class="success-label">加入密码：</text>
          <text class="success-value" selectable="{{true}}" user-select="{{true}}">{{newBabyCode}}</text>
        </view>
        <view class="form-actions">
          <view class="form-submit form-submit-full" bindtap="copyNewBaby" hover-class="btn-hover">复制并关闭</view>
        </view>
      </view>

      <view class="logout-row" wx:if="{{formMode === '' && userInfo.openid}}">
        <view class="logout-btn" bindtap="handleLogout" hover-class="btn-hover">退出登录</view>
      </view>
      <view class="logout-row" wx:elif="{{formMode === '' && !userInfo.openid}}">
        <view class="logout-btn logout-btn-login" bindtap="showLoginInPanel" hover-class="btn-hover">登录以永久保存数据</view>
      </view>

      <view class="feedback-row" wx:if="{{formMode === ''}}" bindtap="openFeedback" hover-class="feedback-row-hover">
        <text class="feedback-icon">💬</text>
        <text class="feedback-text">意见反馈</text>
        <text class="feedback-arrow">›</text>
      </view>

      <view class="sleep-cancel-link" bindtap="hideBabyPanel">关闭</view>
    </view>
  </view>

  <!-- 意见反馈弹层 -->
  <view class="sheet-mask feedback-mask" wx:if="{{showFeedbackSheet}}" bindtap="closeFeedback" catchtouchmove="noop">
    <view class="feedback-panel" catchtap="noop">
      <view class="sheet-handle" bindtouchstart="_onSheetTouchStart" bindtouchmove="_onSheetTouchMove" bindtouchend="_onSheetTouchEnd"></view>
      <view class="feedback-title">意见反馈</view>
      <view class="feedback-sub">你的建议会帮助我们做得更好 🌱（约1-2个工作日查看）</view>

      <scroll-view class="feedback-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="feedback-inner">
          <view class="feedback-type-row">
            <view
              class="feedback-type-btn {{feedbackType === item.key ? 'active' : ''}}"
              wx:for="{{feedbackTypes}}" wx:key="key"
              data-key="{{item.key}}"
              bindtap="onFeedbackTypeTap"
              hover-class="btn-hover"
            >{{item.label}}</view>
          </view>

          <view class="feedback-label">反馈内容</view>
          <textarea
            class="feedback-textarea"
            placeholder="请描述你遇到的问题或建议（必填）"
            value="{{feedbackContent}}"
            bindinput="onFeedbackInput"
            maxlength="500"
          ></textarea>
          <view class="feedback-count">{{feedbackContent.length}}/500</view>

          <view class="feedback-label">联系方式（选填）</view>
          <input class="feedback-input" placeholder="微信号 / 手机号 / 邮箱" value="{{feedbackContact}}" bindinput="onFeedbackContactInput" maxlength="50" />

          <view class="feedback-privacy-tip">仅用于就本次反馈与你沟通，不会用作其他用途</view>

          <view class="feedback-actions">
            <view class="feedback-cancel" bindtap="closeFeedback" hover-class="btn-hover">取消</view>
            <view class="feedback-submit {{feedbackSending ? 'disabled' : ''}}" bindtap="submitFeedback" hover-class="btn-hover">{{feedbackSending ? '提交中…' : '提交反馈'}}</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 登录引导面板 -->
  <login-panel id="loginPanel" bind:change="onLoginPanelChange" />
</view>