<!-- pages/index/index.wxml - 首页（天气皮肤 + 预测卡 + 相册轮播 + 单行记录） -->
<view class="page-index safe-bottom">

  <!-- ===== 天气皮肤背景层（纯装饰，最底层） ===== -->
  <view class="weather-bg wx-{{weatherClass}}">
    <!-- 晴：太阳光晕 + 云朵 -->
    <block wx:if="{{weatherClass === 'sunny'}}">
      <view class="sun-glow"></view>
      <view class="cloud cloud-1"></view>
      <view class="cloud cloud-2"></view>
      <view class="cloud cloud-3"></view>
    </block>
    <!-- 多云：灰白云 -->
    <block wx:if="{{weatherClass === 'cloudy'}}">
      <view class="cloud cloud-1 cloud-dim"></view>
      <view class="cloud cloud-2 cloud-dim"></view>
    </block>
    <!-- 雨：玻璃水雾 + 雨丝 -->
    <block wx:if="{{weatherClass === 'rain'}}">
      <view class="glass-mist"></view>
      <view class="rain-layer"></view>
      <view class="droplet droplet-1"></view>
      <view class="droplet droplet-2"></view>
    </block>
    <!-- 雪 -->
    <block wx:if="{{weatherClass === 'snow'}}">
      <view class="snow-layer"></view>
    </block>
    <!-- 风：落叶风絮 -->
    <block wx:if="{{weatherClass === 'wind'}}">
      <view class="leaf leaf-1">🍂</view>
      <view class="leaf leaf-2">🍃</view>
      <view class="leaf leaf-3">🍁</view>
      <view class="leaf leaf-4">🍃</view>
      <view class="leaf leaf-5">🍂</view>
    </block>
  </view>

  <!-- ===== 页面内容层 ===== -->
  <view class="content-layer">

    <!-- 顶部宝宝信息 -->
    <view class="header">
      <view class="baby-avatar" bindtap="goProfile" hover-class="avatar-tap" hover-stay-time="80">
        <image wx:if="{{babyInfo.avatar}}" class="avatar-img" src="{{babyInfo.avatar}}" mode="aspectFill"></image>
        <view wx:else class="avatar-emoji">👶</view>
      </view>
      <view class="baby-info">
        <view class="baby-name">{{babyInfo.name || '宝宝'}}</view>
        <view class="baby-meta">{{babyInfo.age || '新生儿'}}</view>
      </view>
      <view class="weather-chip" wx:if="{{weatherText}}">{{weatherText}}</view>
      <view class="date-badge" wx:else>{{todayText}}</view>
    </view>

    <!-- 网络状态提示 -->
    <view class="offline-tip" wx:if="{{isOffline}}">
      <text>📴 当前离线，记录已保存本地，联网后自动同步</text>
    </view>

    <!-- 云开发未就绪提示（仅开发期） -->
    <view class="env-tip" wx:if="{{!cloudReady}}">
      <text>🔧 云开发未开通，当前为离线模式。记录会保存到本地，开通云环境后自动同步。</text>
    </view>

    <!-- ===== 三栏智能预测卡（对齐时光轴，适配首页奶咖色系） ===== -->
    <view class="predict-card" wx:if="{{hasPrediction}}">
      <view class="predict-col {{item.overdue ? 'overdue' : ''}}" wx:for="{{predictList}}" wx:key="key">
        <view class="predict-icon">{{item.icon}}</view>
        <view class="predict-label">{{item.label}}</view>
        <view class="predict-time {{item.overdue ? 'predict-time-overdue' : ''}}" wx:if="{{item.available}}">{{item.predictedText}}</view>
        <view class="predict-time predict-time-empty" wx:else>{{item.predictedText}}</view>
        <view class="predict-countdown" wx:if="{{item.available}}">{{item.countdownText}}</view>
      </view>
    </view>

    <!-- ===== 宝宝封面相册（横板轮播） ===== -->
    <view class="album">
      <swiper
        wx:if="{{albumPhotos.length > 0}}"
        class="album-swiper"
        indicator-dots="{{albumPhotos.length > 1}}"
        indicator-color="rgba(255,255,255,0.4)"
        indicator-active-color="#FFFFFF"
        autoplay="{{albumPhotos.length > 1}}"
        interval="4000"
        circular="{{albumPhotos.length > 1}}"
      >
        <swiper-item wx:for="{{albumPhotos}}" wx:key="id">
          <view class="album-item" longpress="removeAlbumPhoto" data-index="{{index}}">
            <image class="album-img" src="{{item.src}}" mode="aspectFill" lazy-load="{{true}}"></image>
          </view>
        </swiper-item>
        <!-- 上传入口：不足 9 张时显示 -->
        <swiper-item wx:if="{{albumPhotos.length < 9 && albumPhotos.length > 0}}">
          <view class="album-item album-add" bindtap="addAlbumPhoto" hover-class="album-add-hover">
            <view class="album-add-icon">📷</view>
            <view class="album-add-text">上传照片</view>
            <view class="album-add-sub">{{albumPhotos.length}}/9</view>
          </view>
        </swiper-item>
      </swiper>

      <!-- 空相册：整卡即上传入口 -->
      <view class="album-empty" wx:if="{{albumPhotos.length === 0}}" bindtap="addAlbumPhoto" hover-class="album-add-hover">
        <view class="album-add-icon">📷</view>
        <view class="album-add-text">为宝宝添加封面相册</view>
        <view class="album-add-sub">记录每一个可爱瞬间</view>
      </view>
    </view>

    <!-- ===== 记录控件：三卡一行 ===== -->
    <view class="record-row">
      <!-- 喂奶 -->
      <view
        class="record-card feed-card {{feedPress ? 'pressing' : ''}}"
        bindtap="handleFeed"
        hover-class="none"
      >
        <view class="mini-success" wx:if="{{feedSuccess}}"><text>✓</text></view>
        <view class="record-icon-wrap">
          <image class="record-icon" src="/images/icons/bottle.svg" mode="aspectFit"></image>
        </view>
        <view class="record-label">喂奶</view>
        <view class="card-info" wx:if="{{cardTexts.feed.elapsed !== '--'}}">
          <view class="info-row">{{cardTexts.feed.elapsed}}</view>
          <view class="info-row info-next" wx:if="{{cardTexts.feed.next}}">{{cardTexts.feed.next}}</view>
        </view>
        <view class="record-hint" wx:else>点击记录</view>
      </view>

      <!-- 换尿布 -->
      <view
        class="record-card diaper-card {{diaperPress ? 'pressing' : ''}}"
        bindtap="handleDiaper"
        hover-class="none"
      >
        <view class="mini-success" wx:if="{{diaperSuccess}}"><text>✓</text></view>
        <view class="record-icon-wrap">
          <image class="record-icon" src="/images/icons/diaper.svg" mode="aspectFit"></image>
        </view>
        <view class="record-label">换尿布</view>
        <view class="card-info" wx:if="{{cardTexts.diaper.elapsed !== '--'}}">
          <view class="info-row">{{cardTexts.diaper.elapsed}}</view>
          <view class="info-row info-next" wx:if="{{cardTexts.diaper.next}}">{{cardTexts.diaper.next}}</view>
        </view>
        <view class="record-hint" wx:else>点击记录</view>
      </view>

      <!-- 睡觉 -->
      <view
        class="record-card sleep-card {{sleepPress ? 'pressing' : ''}} {{sleeping ? 'sleeping-state' : ''}}"
        bindtap="handleSleep"
        hover-class="none"
      >
        <view class="mini-success" wx:if="{{sleepSuccess}}"><text>✓</text></view>
        <view class="record-icon-wrap">
          <image class="record-icon" src="/images/icons/moon.svg" mode="aspectFit"></image>
        </view>
        <view class="record-label">{{sleeping ? '已入睡' : '睡觉'}}</view>
        <view class="card-info" wx:if="{{cardTexts.sleep.elapsed && cardTexts.sleep.elapsed !== '--'}}">
          <view class="info-row">{{cardTexts.sleep.elapsed}}</view>
          <view class="info-row info-next" wx:if="{{cardTexts.sleep.next}}">{{cardTexts.sleep.next}}</view>
        </view>
        <view class="record-hint" wx:else>点击</view>
      </view>
    </view>

    <!-- 底部小提示 -->
    <view class="bottom-hint">
      <text>👆 一键即记 · 长按相册照片可删除</text>
    </view>
  </view>

  <!-- ========== 睡眠操作弹层 ========== -->
  <view class="sheet-mask" wx:if="{{showSleepSheet}}" bindtap="hideSleepSheet" catchtouchmove="noop">
    <view class="sleep-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sleep-sheet-title">{{sleeping ? '结束睡眠' : '记录睡眠'}}</view>

      <!-- 已入睡：显示当前睡眠时长 + 结束按钮 -->
      <block wx:if="{{sleeping}}">
        <view class="sleep-current">
          <view class="sleep-current-num">{{sleepDurationText}}</view>
          <view class="sleep-current-label">已入睡时长</view>
        </view>
        <view class="sleep-action-btn sleep-action-primary" bindtap="endSleep" hover-class="btn-hover">
          🌅 宝宝起床了
        </view>
        <view class="sleep-cancel-link" bindtap="hideSleepSheet">取消</view>
      </block>

      <!-- 未入睡：三个快捷操作 -->
      <block wx:else>
        <view class="sleep-action-btn sleep-action-primary" bindtap="startSleep" hover-class="btn-hover">
          🌙 宝宝刚刚入睡
        </view>
        <view class="sleep-action-btn sleep-action-secondary" bindtap="showDurationPicker" hover-class="btn-hover">
          ⏱ 回忆记录（选择时长）
        </view>
        <view class="sleep-cancel-link" bindtap="hideSleepSheet">取消</view>
      </block>
    </view>
  </view>

  <!-- ========== 时长选择器弹层 ========== -->
  <view class="sheet-mask" wx:if="{{showDurationPicker}}" bindtap="hideDurationPicker" catchtouchmove="noop">
    <view class="sleep-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sleep-sheet-title">睡了多久？</view>
      <view class="duration-grid">
        <view class="duration-item" data-minutes="30" bindtap="selectDuration" hover-class="duration-item-hover">30分钟</view>
        <view class="duration-item" data-minutes="60" bindtap="selectDuration" hover-class="duration-item-hover">1小时</view>
        <view class="duration-item" data-minutes="90" bindtap="selectDuration" hover-class="duration-item-hover">1.5小时</view>
        <view class="duration-item" data-minutes="120" bindtap="selectDuration" hover-class="duration-item-hover">2小时</view>
        <view class="duration-item" data-minutes="150" bindtap="selectDuration" hover-class="duration-item-hover">2.5小时</view>
        <view class="duration-item" data-minutes="180" bindtap="selectDuration" hover-class="duration-item-hover">3小时</view>
        <view class="duration-item" data-minutes="240" bindtap="selectDuration" hover-class="duration-item-hover">4小时</view>
        <view class="duration-item" data-minutes="480" bindtap="selectDuration" hover-class="duration-item-hover">8小时</view>
      </view>
      <view class="sleep-cancel-link" bindtap="hideDurationPicker">取消</view>
    </view>
  </view>
</view>
