<!-- pages/index/index.wxml - 首页极简打卡 -->
<view class="page-index safe-bottom">
  <!-- 顶部宝宝信息 -->
  <view class="header">
    <view class="baby-avatar">👶</view>
    <view class="baby-info">
      <view class="baby-name">{{babyInfo.name || '宝宝'}}</view>
      <view class="baby-meta">{{babyInfo.age || '新生儿'}}</view>
    </view>
    <view class="date-badge">{{todayText}}</view>
  </view>

  <!-- 网络状态提示 -->
  <view class="offline-tip" wx:if="{{isOffline}}">
    <text>📴 当前离线，记录已保存到本地，恢复网络后自动同步</text>
  </view>

  <!-- 智能预测提示区 -->
  <view class="prediction-area" wx:if="{{predictions.feed || predictions.diaper || predictions.sleep}}">
    <view class="predict-card" wx:if="{{predictions.feed}}">
      <text class="predict-label">🍼 {{predictions.feed}}</text>
    </view>
    <view class="predict-card" wx:if="{{predictions.diaper}}">
      <text class="predict-label">🧷 {{predictions.diaper}}</text>
    </view>
    <view class="predict-card" wx:if="{{predictions.sleep}}">
      <text class="predict-label">🌙 {{predictions.sleep}}</text>
    </view>
  </view>

  <!-- 三大记录按钮区 -->
  <view class="buttons-area">
    <record-button
      wx:for="{{recordTypes}}"
      wx:key="type"
      type="{{item.type}}"
      label="{{item.label}}"
      icon="{{item.icon}}"
      color="{{item.color}}"
      elapsedTime="{{elapsedTexts[item.type]}}"
      bindtap="handleRecord"
    />
  </view>

  <!-- 底部小提示 -->
  <view class="bottom-hint">
    <text>👆 点击按钮即记录，长按可补充详情</text>
  </view>
</view>
