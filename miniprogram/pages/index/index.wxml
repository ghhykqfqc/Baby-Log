<!-- pages/index/index.wxml - 首页极简打卡（差异化布局 + 图标修复） -->
<view class="page-index safe-bottom">
  <!-- 顶部宝宝信息 -->
  <view class="header">
    <view class="baby-avatar">👶</view>
    <view class="baby-info">
      <view class="baby-name">{{babyInfo.name || '宝宝'}}</view>
      <view class="baby-meta">{{babyInfo.age || '新生儿'}}</view>
    </view>
    <view class="date-badge">{{todayText}}</view>
  </view>

  <!-- 网络状态提示 -->
  <view class="offline-tip" wx:if="{{isOffline}}">
    <text>📴 当前离线，记录已保存本地，联网后自动同步</text>
  </view>

  <!-- 云开发未就绪提示（仅开发期） -->
  <view class="env-tip" wx:if="{{!cloudReady}}">
    <text>🔧 云开发未开通，当前为离线模式。记录会保存到本地，开通云环境后自动同步。</text>
  </view>

  <!-- 智能预测提示区 -->
  <view class="prediction-area" wx:if="{{hasPrediction}}">
    <view class="predict-pill" wx:if="{{predictions.feed}}">
      <text class="pill-text">🍼 {{predictions.feed}}</text>
    </view>
    <view class="predict-pill" wx:if="{{predictions.sleep}}">
      <text class="pill-text">🌙 {{predictions.sleep}}</text>
    </view>
  </view>

  <!-- ============ 主操作区：差异化布局 ============ -->

  <!-- 喂奶：占据视觉中心的大卡片 -->
  <view
    class="feed-card {{feedPress ? 'pressing' : ''}}"
    bindtap="handleFeed"
    hover-class="none"
  >
    <!-- 成功反馈遮罩 -->
    <view class="success-overlay" wx:if="{{feedSuccess}}">
      <view class="success-check">✓</view>
      <view class="success-label">已记录喂奶</view>
    </view>

    <!-- 奶瓶图标（image 引用 SVG，小程序不支持内联 svg 标签） -->
    <view class="feed-icon-wrap">
      <view class="feed-glow"></view>
      <image class="feed-icon" src="/images/icons/bottle.svg" mode="aspectFit"></image>
    </view>

    <view class="feed-label">喂奶</view>
    <view class="feed-elapsed" wx:if="{{elapsedTexts.feed !== '--'}}">
      距上次 <text class="elapsed-num">{{elapsedTexts.feed}}</text>
    </view>
    <view class="feed-hint" wx:else>点击记录</view>
  </view>

  <!-- 下方两个不对称卡片 -->
  <view class="dual-area">
    <!-- 换尿布 -->
    <view
      class="dual-card diaper-card {{diaperPress ? 'pressing' : ''}}"
      bindtap="handleDiaper"
      hover-class="none"
    >
      <view class="mini-success" wx:if="{{diaperSuccess}}">
        <text>✓</text>
      </view>
      <view class="dual-icon-wrap">
        <image class="dual-icon" src="/images/icons/diaper.svg" mode="aspectFit"></image>
      </view>
      <view class="dual-label">换尿布</view>
      <view class="dual-elapsed" wx:if="{{elapsedTexts.diaper !== '--'}}">{{elapsedTexts.diaper}}</view>
      <view class="dual-hint" wx:else>点击</view>
    </view>

    <!-- 睡觉 -->
    <view
      class="dual-card sleep-card {{sleepPress ? 'pressing' : ''}}"
      bindtap="handleSleep"
      hover-class="none"
    >
      <view class="mini-success" wx:if="{{sleepSuccess}}">
        <text>✓</text>
      </view>
      <view class="dual-icon-wrap">
        <image class="dual-icon" src="/images/icons/moon.svg" mode="aspectFit"></image>
      </view>
      <view class="dual-label">睡觉</view>
      <view class="dual-elapsed" wx:if="{{elapsedTexts.sleep !== '--'}}">{{elapsedTexts.sleep}}</view>
      <view class="dual-hint" wx:else>点击</view>
    </view>
  </view>

  <!-- 底部小提示 -->
  <view class="bottom-hint">
    <text>👆 一键即记，单手拇指轻松操作</text>
  </view>
</view>
