/* pages/timeline/timeline.wxss - 时光轴（固定头部 + 列表区滚动 + 分页加载） */

/* 页面骨架：整页不滚动，flex 三段式（头部 / 滚动列表 / 底部按钮） */
.page-timeline {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
  /* 底部让出自定义 tabBar（110rpx + 安全区） */
  padding-bottom: calc(env(safe-area-inset-bottom) + 110rpx);
}

/* ===== 固定头部区 ===== */
.fixed-header {
  flex-shrink: 0;
}

/* 日期头部 */
.date-header {
  padding: 8rpx 4rpx 20rpx;
}

.date-title {
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--color-text-primary);
}

/* ===== 三栏智能预测卡 ===== */
.predict-card {
  display: flex;
  background: var(--color-bg-card);
  border-radius: 32rpx;
  padding: 32rpx 16rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(180, 150, 110, 0.10);
}

.predict-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  padding: 0 8rpx;
  position: relative;
}

.predict-col:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 1rpx;
  background: var(--color-divider);
}

.predict-icon {
  font-size: 44rpx;
  line-height: 1;
  margin-bottom: 12rpx;
}

.predict-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.predict-time {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary-dark);
  font-variant-numeric: tabular-nums;
}

.predict-time-empty {
  color: var(--color-text-hint);
  font-weight: 500;
  font-size: 24rpx;
}

.predict-time-overdue {
  color: var(--color-danger);
}

.predict-countdown {
  font-size: 20rpx;
  color: var(--color-text-hint);
  margin-top: 6rpx;
  font-variant-numeric: tabular-nums;
}

.predict-col.overdue .predict-countdown {
  color: var(--color-danger);
}

/* ===== 当日小结 ===== */
.summary-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: var(--color-primary-bg);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 8rpx;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-item .num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  display: block;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.summary-item .label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  display: block;
}

.divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(180, 150, 110, 0.18);
}

/* ===== 中间滚动列表区 ===== */
.list-scroll {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

/* 首次加载占位 */
.list-loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.list-loading-text {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
}

/* 日期分组标签 */
.date-group-label {
  display: flex;
  align-items: center;
  padding: 28rpx 8rpx 16rpx;
}

.group-line {
  flex: 1;
  height: 1rpx;
  background: var(--color-divider);
}

.group-text {
  padding: 0 20rpx;
  font-size: 22rpx;
  color: var(--color-text-hint);
  letter-spacing: 2rpx;
}

/* 分页加载状态 */
.list-footer {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 8rpx;
}

.footer-text {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.footer-end {
  opacity: 0.7;
}

.footer-hint {
  opacity: 0.8;
}

/* 列表底部留白（与固定按钮保持距离） */
.scroll-tail {
  height: 24rpx;
}

/* ===== 底部固定分享按钮（flex 布局的最后一段，无需 position: fixed） ===== */
.bottom-bar {
  flex-shrink: 0;
  padding: 16rpx 0 8rpx;
}

.share-btn {
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: var(--radius-xl);
  padding: 24rpx;
  text-align: center;
  font-size: var(--font-md);
  font-weight: 600;
  box-shadow: var(--shadow-button);
  transition: transform 0.15s ease;
}

.share-btn-hover {
  transform: scale(0.97);
}
