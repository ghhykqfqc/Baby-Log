/* pages/timeline/timeline.wxss - 时光轴（摘要卡 + 自定义时间线图） */

/* 整页锁定一屏：不滚动 */
.page-timeline {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
  padding-bottom: calc(env(safe-area-inset-bottom) + 110rpx);
}

/* ===== 固定头部区 ===== */
.fixed-header {
  flex-shrink: 0;
}

.date-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 16rpx;
}

.date-title {
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--color-text-primary);
}

/* ===== 预测卡 ===== */
.predict-card {
  display: flex;
  flex-shrink: 0;
  background: var(--color-bg-card);
  border-radius: 32rpx;
  padding: 24rpx 16rpx 22rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(180, 150, 110, 0.10);
}

.predict-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  padding: 0 8rpx;
  position: relative;
}

.predict-col:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 1rpx;
  background: var(--color-divider);
}

.predict-icon {
  font-size: 44rpx;
  line-height: 1;
  margin-bottom: 12rpx;
}

.predict-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.predict-time {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary-dark);
  font-variant-numeric: tabular-nums;
}

.predict-time-empty {
  color: var(--color-text-hint);
  font-weight: 500;
  font-size: 24rpx;
}

.predict-time-overdue {
  color: var(--color-danger);
}

.predict-countdown {
  font-size: 20rpx;
  color: var(--color-text-hint);
  margin-top: 6rpx;
  font-variant-numeric: tabular-nums;
}

.predict-col.overdue .predict-countdown {
  color: var(--color-danger);
}

/* ===== 当日摘要卡 ===== */
.summary-card {
  flex-shrink: 0;
  background: var(--color-bg-card);
  border-radius: 32rpx;
  padding: 28rpx 24rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(180, 150, 110, 0.10);
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.summary-col {
  flex: 1;
  text-align: center;
}

.summary-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  display: block;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.sleep-num {
  font-size: 34rpx;
}

.summary-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  display: block;
}

.summary-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--color-divider);
}

/* 记录列表入口按钮（在日期标题行右侧） */
.records-entry {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 18rpx;
  background: var(--color-primary-bg);
  border-radius: 24rpx;
  transition: transform 0.15s ease, background 0.2s ease;
}

.records-entry-hover {
  transform: scale(0.94);
  background: var(--color-primary-light);
}

.records-entry-icon {
  font-size: 22rpx;
  line-height: 1;
}

.records-entry-text {
  font-size: 22rpx;
  color: var(--color-primary-dark);
  font-weight: 500;
}

/* 睡眠时段明细 */
.sleep-sessions {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-divider);
}

.sleep-sessions-label {
  font-size: 20rpx;
  color: var(--color-text-hint);
  display: block;
  margin-bottom: 10rpx;
}

.sleep-sessions-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.sleep-session {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(139, 122, 170, 0.08);
  border-radius: 16rpx;
  padding: 6rpx 14rpx;
}

.sleep-session-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #8B7AAA;
  flex-shrink: 0;
}

.sleep-session-dot.ongoing {
  background: #8B7AAA;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.5; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.1); }
}

.sleep-session-time {
  font-size: 22rpx;
  color: var(--color-text-primary);
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.sleep-session-dur {
  font-size: 20rpx;
  color: var(--color-text-hint);
}

/* ===== 时间线分布图卡 ===== */
.chart-card {
  flex: 1;
  min-height: 0;
  background: var(--color-bg-card);
  border-radius: 32rpx;
  padding: 20rpx 16rpx 12rpx;
  box-shadow: 0 8rpx 32rpx rgba(180, 150, 110, 0.08);
  display: flex;
  flex-direction: column;
}

.chart-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 12rpx;
}

.chart-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.chart-legend {
  display: flex;
  gap: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.legend-feed { background: #E89B5F; }
.legend-diaper { background: #7AAFA8; }

.legend-bar {
  width: 20rpx;
  height: 8rpx;
  border-radius: 4rpx;
}

.legend-sleep { background: #8B7AAA; }

/* 刻度切换标签（日/周/月，参照 Apple Health 风格） */
.chart-scale-tabs {
  display: flex;
  background: var(--color-primary-bg);
  border-radius: 20rpx;
  padding: 4rpx;
  gap: 2rpx;
}

.scale-tab {
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  border-radius: 16rpx;
  transition: all 0.2s ease;
  font-weight: 500;
}

.scale-tab.active {
  background: var(--color-primary);
  color: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(212, 184, 150, 0.3);
}

/* canvas 包裹层（tooltip 定位基准） */
.chart-canvas-wrap {
  flex: 1;
  min-height: 0;
  position: relative;
}

.timeline-chart {
  width: 100%;
  height: 100%;
  min-height: 280rpx;
}

/* 图例（移到 canvas 下方） */
.chart-legend {
  flex-shrink: 0;
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding: 8rpx 0 4rpx;
}

/* 节点详情气泡 */
.chart-tooltip {
  position: absolute;
  z-index: 20;
  background: rgba(61, 48, 39, 0.95);
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  pointer-events: none;
  animation: tooltipIn 0.15s ease;
  max-width: 400rpx;
}

/* 默认在节点上方 */
.chart-tooltip.above {
  transform: translate(-50%, calc(-100% - 12px));
}

/* 近顶部时显示在下方 */
.chart-tooltip.below {
  transform: translate(-50%, 12px);
}

@keyframes tooltipIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 箭头（上方） */
.chart-tooltip.above .tooltip-arrow {
  position: absolute;
  bottom: -6rpx;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 12rpx;
  height: 12rpx;
  background: rgba(61, 48, 39, 0.95);
}

/* 箭头（下方） */
.chart-tooltip.below .tooltip-arrow {
  position: absolute;
  top: -6rpx;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 12rpx;
  height: 12rpx;
  background: rgba(61, 48, 39, 0.95);
}

.tooltip-icon {
  font-size: 28rpx;
  line-height: 1;
}

.tooltip-body {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.tooltip-title {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.tooltip-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  white-space: nowrap;
}

/* ===== 空状态 ===== */
.empty-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 底部分享按钮 ===== */
.bottom-bar {
  flex-shrink: 0;
  padding: 16rpx 0 8rpx;
}

.share-btn {
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: var(--radius-xl);
  padding: 24rpx;
  text-align: center;
  font-size: var(--font-md);
  font-weight: 600;
  box-shadow: var(--shadow-button);
  transition: transform 0.15s ease;
}

.share-btn-hover {
  transform: scale(0.97);
}
