/* pages/timeline/timeline.wxss - 时光轴（预测卡 + 重构） */

.page-timeline {
  min-height: 100vh;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

/* 日期头部 */
.date-header {
  padding: 8rpx 4rpx 20rpx;
}

.date-title {
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--color-text-primary);
}

/* ===== 三栏智能预测卡 ===== */
.predict-card {
  display: flex;
  background: var(--color-bg-card);
  border-radius: 32rpx;
  padding: 32rpx 16rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(180, 150, 110, 0.10);
}

.predict-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  padding: 0 8rpx;
  position: relative;
}

.predict-col:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 1rpx;
  background: var(--color-divider);
}

.predict-icon {
  font-size: 44rpx;
  line-height: 1;
  margin-bottom: 12rpx;
}

.predict-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.predict-time {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary-dark);
  font-variant-numeric: tabular-nums;
}

.predict-time-empty {
  color: var(--color-text-hint);
  font-weight: 500;
  font-size: 24rpx;
}

.predict-time-overdue {
  color: var(--color-danger);
}

.predict-countdown {
  font-size: 20rpx;
  color: var(--color-text-hint);
  margin-top: 6rpx;
  font-variant-numeric: tabular-nums;
}

.predict-col.overdue .predict-countdown {
  color: var(--color-danger);
}

/* ===== 当日小结 ===== */
.summary-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: var(--color-primary-bg);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-item .num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  display: block;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.summary-item .label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  display: block;
}

.divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(180, 150, 110, 0.18);
}

/* ===== 时光轴列表 ===== */
.timeline-list {
  padding-bottom: 160rpx;
}

/* ===== 底部按钮 ===== */
.bottom-bar {
  position: fixed;
  /* 坐落在自定义 tabBar 之上：tabBar 高度 110rpx + 安全区 */
  bottom: calc(env(safe-area-inset-bottom) + 110rpx);
  left: 0;
  right: 0;
  padding: 16rpx 32rpx;
  background: rgba(250, 246, 240, 0.96);
  backdrop-filter: blur(10px);
  border-top: 1rpx solid var(--color-divider);
  z-index: 500;
}

.share-btn {
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: var(--radius-xl);
  padding: 24rpx;
  text-align: center;
  font-size: var(--font-md);
  font-weight: 600;
  box-shadow: var(--shadow-button);
}