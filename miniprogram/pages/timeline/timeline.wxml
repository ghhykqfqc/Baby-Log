<!-- pages/timeline/timeline.wxml - 时光轴（摘要卡 + 自定义时间线分布图） -->
<view class="page-timeline">
  <!-- ========== 固定头部区 ========== -->
  <view class="fixed-header">
    <!-- 日期标题 + 记录入口 -->
    <view class="date-header">
      <view class="date-title">{{todayLabel}}</view>
      <view class="records-entry" wx:if="{{!loading && hasRecords}}" bindtap="goRecords" hover-class="records-entry-hover" hover-stay-time="80">
        <text class="records-entry-icon">📋</text>
        <text class="records-entry-text">记录</text>
      </view>
    </view>

    <!-- 三栏智能预测卡 -->
    <view class="predict-card" wx:if="{{!loading && hasRecords && hasPrediction}}">
      <view class="predict-col {{item.overdue ? 'overdue' : ''}}" wx:for="{{predictList}}" wx:key="key" data-key="{{item.key}}">
        <view class="predict-icon">{{item.icon}}</view>
        <view class="predict-label">{{item.label}}</view>
        <view class="predict-time {{item.overdue ? 'predict-time-overdue' : ''}}" wx:if="{{item.available}}">{{item.predictedText}}</view>
        <view class="predict-time predict-time-empty" wx:else>{{item.predictedText}}</view>
        <view class="predict-countdown" wx:if="{{item.available}}">{{item.countdownText}}</view>
      </view>
    </view>

    <!-- 当日摘要卡 -->
    <view class="summary-card" wx:if="{{!loading && hasRecords}}">
      <view class="summary-row">
        <view class="summary-col">
          <text class="summary-num">{{summary.feedCount}}</text>
          <text class="summary-label">喂奶</text>
        </view>
        <view class="summary-divider"></view>
        <view class="summary-col">
          <text class="summary-num">{{summary.diaperCount}}</text>
          <text class="summary-label">换尿布</text>
        </view>
        <view class="summary-divider"></view>
        <view class="summary-col">
          <text class="summary-num sleep-num">{{summary.sleepDurationText}}</text>
          <text class="summary-label">睡眠</text>
        </view>
      </view>
      <!-- 睡眠时段明细 -->
      <view class="sleep-sessions" wx:if="{{summary.sleepSessions.length > 0}}">
        <text class="sleep-sessions-label">睡眠时段</text>
        <view class="sleep-sessions-list">
          <view class="sleep-session" wx:for="{{summary.sleepSessions}}" wx:key="index">
            <view class="sleep-session-dot {{item.ongoing ? 'ongoing' : ''}}"></view>
            <text class="sleep-session-time">{{item.startText}}-{{item.endText}}</text>
            <text class="sleep-session-dur">{{item.durationText}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 今日时间线分布图 ========== -->
  <view class="chart-card" wx:if="{{!loading && hasChartData}}">
    <view class="chart-head">
      <view class="chart-title">{{chartScale === 'hour' ? '近3小时' : chartScale === 'day' ? '今日时间线' : chartScale === 'week' ? '本周概览' : '本月概览'}}</view>
      <view class="chart-scale-tabs">
        <view class="scale-tab {{chartScale === 'hour' ? 'active' : ''}}" data-scale="hour" bindtap="switchScale">时</view>
        <view class="scale-tab {{chartScale === 'day' ? 'active' : ''}}" data-scale="day" bindtap="switchScale">日</view>
        <view class="scale-tab {{chartScale === 'week' ? 'active' : ''}}" data-scale="week" bindtap="switchScale">周</view>
        <view class="scale-tab {{chartScale === 'month' ? 'active' : ''}}" data-scale="month" bindtap="switchScale">月</view>
      </view>
    </view>
    <view class="chart-canvas-wrap">
      <canvas type="2d" id="timelineChart" class="timeline-chart" bindtap="onChartTap"></canvas>
    </view>
    <!-- 图例（仅日视图显示） -->
    <view class="chart-legend" wx:if="{{chartScale === 'day'}}">
      <view class="legend-item"><view class="legend-dot legend-feed"></view><text>喂奶</text></view>
      <view class="legend-item"><view class="legend-dot legend-diaper"></view><text>尿布</text></view>
      <view class="legend-item"><view class="legend-bar legend-sleep"></view><text>睡眠</text></view>
    </view>
  </view>

  <!-- 空状态（占据剩余空间） -->
  <view class="empty-wrap" wx:if="{{!loading && !hasRecords}}">
    <empty-state icon="🌱" title="今天还没有记录哦" subtitle="去首页点击按钮，记录宝宝的第一条作息" />
  </view>

  <!-- ========== 底部固定分享按钮 ========== -->
  <view class="bottom-bar">
    <view class="share-btn" bindtap="goShareCard" hover-class="share-btn-hover" hover-stay-time="80">
      <text>📸 生成分享卡片</text>
    </view>
  </view>
</view>
