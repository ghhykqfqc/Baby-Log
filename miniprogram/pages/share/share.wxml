<!-- pages/share/share.wxml - 每日小结分享卡片（3 套主题 + Canvas 修复） -->
<view class="page-share safe-bottom">

  <!-- 游客拦截占位：分享卡含宝宝数据，游客不可生成 -->
  <view class="guest-block" wx:if="{{guestBlocked}}">
    <view class="guest-block-icon">🔒</view>
    <view class="guest-block-title">登录后才能查看分享卡</view>
    <view class="guest-block-sub">这是家人分享的宝宝记录卡片，登录后即可查看并继续记录宝宝点滴</view>
    <view class="guest-block-btn" bindtap="guestGoLogin">去登录</view>
    <view class="guest-block-back" bindtap="guestGoBack">返回</view>
  </view>

  <!-- 无权限查看分享的宝宝（非家庭成员） -->
  <view class="guest-block" wx:elif="{{accessDenied}}">
    <view class="guest-block-icon">🔍</view>
    <view class="guest-block-title">暂无法查看该分享</view>
    <view class="guest-block-sub">分享的宝宝记录属于家庭成员数据，请先在首页「家庭共享」中加入该宝宝</view>
    <view class="guest-block-btn" bindtap="goHome">去首页</view>
    <view class="guest-block-back" bindtap="guestGoBack">返回</view>
  </view>

  <!-- 正常内容（登录态或有分享快照时显示；无权限访问才拦截） -->
  <block wx:if="{{!guestBlocked && !accessDenied}}">

  <!-- 分享落地引导条：来自家人分享的卡片，提供「登录 / 首页」捷径（游客也可完整浏览） -->
  <view class="shared-banner" wx:if="{{sharedView}}">
    <view class="shared-banner-icon">💌</view>
    <view class="shared-banner-text">
      <view class="shared-banner-title">这是家人分享的宝宝日志</view>
      <view class="shared-banner-sub">登录后即可创建自己的宝宝，开始记录成长点滴</view>
    </view>
    <view class="shared-banner-actions">
      <view class="shared-banner-btn primary" bindtap="guestGoLogin">登录</view>
      <view class="shared-banner-btn ghost" bindtap="goHome">首页</view>
    </view>
  </view>

  <!-- 顶部标题栏 -->
  <view class="share-header">
    <view class="title">每日小结</view>
    <view class="subtitle">{{todayLabel}} · {{weekdayText}}</view>
  </view>

  <!-- 主题切换 Tab -->
  <view class="theme-tabs">
    <view
      wx:for="{{themes}}"
      wx:key="key"
      class="theme-tab {{currentTheme === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchTheme"
    >
      <text class="tab-icon">{{item.icon}}</text>
      <text class="tab-label">{{item.label}}</text>
    </view>
  </view>

  <!-- 卡片预览区 -->
  <view class="canvas-container" wx:if="{{!loading}}">
    <canvas
      type="2d"
      id="shareCanvas"
      class="share-canvas"
    ></canvas>
  </view>

  <!-- 加载状态 -->
  <view class="loading-area" wx:if="{{loading}}">
    <view class="loading-dot"></view>
    <view class="loading-dot"></view>
    <view class="loading-dot"></view>
    <view class="loading-text">正在生成卡片...</view>
  </view>

  <!-- 数据来源提示 -->
  <view class="data-source" wx:if="{{dataSource}}">
    <text class="source-text">{{dataSource}}</text>
  </view>

  <!-- 操作按钮（分享落地视图同样完整可用，游客保存/分享仅基于快照数据，无云端写入） -->
  <view class="actions">
    <view class="action-btn primary" bindtap="saveImage">
      <text>💾 保存图片到相册</text>
    </view>
    <button class="action-btn secondary" open-type="share">
      <text>💬 分享给好友</text>
    </button>
  </view>

  <view class="tip">
    <text>保存图片后可分享到朋友圈或家族群</text>
  </view>
  </block>
</view>
