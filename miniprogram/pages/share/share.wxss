/* pages/share/share.wxss */

.page-share {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.canvas-container {
  width: 100%;
  max-width: 600rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(180, 150, 110, 0.2);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.share-canvas {
  width: 100%;
  height: 850rpx;
}

.actions {
  width: 100%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  padding: 24rpx;
  border-radius: var(--radius-md);
  text-align: center;
  font-size: var(--font-md);
  font-weight: 600;
}

.action-btn.primary {
  background: var(--color-primary);
  color: #FFFFFF;
  box-shadow: var(--shadow-button);
}

.action-btn.secondary {
  background: var(--color-bg-card);
  color: var(--color-text-primary);
  border: 1rpx solid var(--color-divider);
  padding: 24rpx;
  border-radius: var(--radius-md);
}

.tip {
  margin-top: 24rpx;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  text-align: center;
}
