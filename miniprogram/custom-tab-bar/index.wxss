/* custom-tab-bar/index.wxss - 自定义底部导航 */

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: stretch;
  height: 110rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(212, 184, 150, 0.18);
  box-shadow: 0 -4rpx 24rpx rgba(180, 150, 110, 0.06);
  z-index: 1000;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 16rpx;
  position: relative;
  transition: transform 0.15s ease;
}

.tab-bar-item.active {
  transform: translateY(-2rpx);
}

.tab-icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  transition: transform 0.2s ease;
}

.tab-bar-item.active .tab-icon {
  transform: scale(1.1);
}

/* 选中态顶部小圆点指示 */
.tab-dot {
  position: absolute;
  top: -10rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #D4B896;
  box-shadow: 0 0 0 4rpx rgba(212, 184, 150, 0.2);
}

.tab-text {
  font-size: 20rpx;
  letter-spacing: 1rpx;
  font-weight: 500;
  transition: color 0.2s;
}

.tab-bar-item.active .tab-text {
  font-weight: 600;
}
